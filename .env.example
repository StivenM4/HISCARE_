# ==============================================================================
# HISCARE - Configuración de Variables de Entorno (.env.example)
# ==============================================================================
#
# Cadena de conexión a PostgreSQL (DATABASE_URL):
# El script maestro de esquema y reglas (bd/01_esquema_y_reglas.sql) crea automáticamente
# el rol de aplicación bajo el Principio de Menor Privilegio (PoLP):
#   - Rol / Usuario:           hiscare_app
#   - Contraseña predefinida:  cambiar_en_produccion
#   - Base de datos:           hiscare
#
# NOTA PARA DESARROLLO LOCAL:
# Si su entorno local de PostgreSQL utiliza el superusuario 'postgres' u otro usuario
# personalizado, ajuste la URL según corresponda:
#   DATABASE_URL=postgresql://postgres:su_password@127.0.0.1:5432/hiscare
#
# NOTA PARA PRODUCCIÓN:
# Alerte y cambie tanto la contraseña del rol 'hiscare_app' en PostgreSQL como SESSION_SECRET.
DATABASE_URL=postgresql://hiscare_app:cambiar_en_produccion@127.0.0.1:5432/hiscare

# Secreto criptográfico de sesión (Obligatorio cambiar por una cadena aleatoria y segura en producción)
SESSION_SECRET=cambiar-por-una-cadena-larga

# Puerto de escucha del servidor HTTP Express
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Zona horaria oficial para registro médico y auditoría clínica (Colombia / Bogotá - UTC-5)
TZ=America/Bogota

# Dominio corporativo oficial para correos electrónicos institucionales
DOMINIO_CORREO=hiscare.edu.co

# Directorio físico para almacenamiento seguro de archivos adjuntos (C.24 / C.25)
# Si es relativo, se resuelve respecto a la raíz del proyecto (process.cwd())
UPLOAD_DIR=uploads/resultados

# Tamaño máximo permitido para archivos clínicos adjuntos en Megabytes (MB) (HIS-F-29 / HIS-E-08)
MAX_UPLOAD_MB=10

# Días de vigencia predeterminados para órdenes médicas diagnósticas (LABORATORIO y RADIOLOGÍA)
ORDEN_VIGENCIA_DIAS=30

# URL del subsistema de integración LIS (Laboratory Information System)
LIS_URL=http://127.0.0.1:3000/mock/lis

# URL del subsistema de integración RIS (Radiology Information System)
RIS_URL=http://127.0.0.1:3000/mock/ris
