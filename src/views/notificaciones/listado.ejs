<%- include('../partials/_inicio', { titulo: 'Centro de notificaciones y alertas clínicas', figuraTrace: 'C11' }) %>

<%
  const listaNotifs = (typeof notificaciones !== 'undefined' && Array.isArray(notificaciones)) ? notificaciones : [];
  const filtroLeidoVal = (typeof filtroLeido !== 'undefined' && filtroLeido !== null) ? String(filtroLeido) : '';
  const filtroPrioVal = (typeof filtroPrioridad !== 'undefined' && filtroPrioridad !== null) ? String(filtroPrioridad).toUpperCase() : '';
  const filtroParam = (typeof filtro !== 'undefined' && filtro) ? String(filtro).toLowerCase() : '';

  let filtroActual = 'todas';
  if (filtroLeidoVal === 'false' || filtroLeidoVal === '0' || filtroLeidoVal === 'no_leidas' || filtroParam === 'no_leidas') {
    filtroActual = 'no_leidas';
  } else if (filtroPrioVal === 'CRITICA' || filtroParam === 'criticas') {
    filtroActual = 'criticas';
  }

  function urlPaginaNotif(pag) {
    if (filtroActual === 'no_leidas') {
      return `/notificaciones?leido=false&filtro=no_leidas&pagina=${pag}`;
    } else if (filtroActual === 'criticas') {
      return `/notificaciones?prioridad=CRITICA&filtro=criticas&pagina=${pag}`;
    }
    return `/notificaciones?filtro=todas&pagina=${pag}`;
  }

  const pagActual = (typeof pagina !== 'undefined' && Number(pagina) > 0) ? Number(pagina) : 1;
  const pagTotales = (typeof totalPaginas !== 'undefined' && Number(totalPaginas) > 0) ? Number(totalPaginas) : 1;
  const totRegistros = (typeof total !== 'undefined' && Number(total) >= 0) ? Number(total) : listaNotifs.length;
  const cantNoLeidas = (typeof conteoNoLeidas !== 'undefined' && Number(conteoNoLeidas) >= 0)
    ? Number(conteoNoLeidas)
    : listaNotifs.filter(n => !n.leido).length;
  const cantCriticas = (typeof conteoCriticas !== 'undefined' && Number(conteoCriticas) >= 0)
    ? Number(conteoCriticas)
    : listaNotifs.filter(n => n.prioridad === 'CRITICA').length;
%>

<div class="container-fluid px-0">
  <!-- Cabecera de notificaciones -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
          <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Inicio</a></li>
          <li class="breadcrumb-item active" aria-current="page">Notificaciones</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-dark mb-1 d-flex align-items-center gap-2">
        <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        Centro de notificaciones y alertas clínicas
      </h1>
      <p class="text-muted small mb-0">
        Monitoreo en tiempo real de resultados de laboratorio, radiología y alertas prioritarias del paciente.
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <!-- [11.51] Botón Marcar todas como leídas -->
      <button type="button"
              class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 shadow-sm rounded-pill px-3"
              id="btnMarcarTodasLeidasVista"
              data-trace="C11-51">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Marcar todas como leídas</span>
      </button>
    </div>
  </div>

  <!-- [11.49] Texto informativo / Callout de reintento y persistencia -->
  <div class="alert alert-info d-flex align-items-center gap-3 mb-4 shadow-sm border-0 border-start border-4 border-info bg-light"
       role="alert"
       data-trace="C11-49">
    <div class="text-info flex-shrink-0">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <div class="small text-dark">
      <strong>Información del sistema:</strong> Si una notificación no se genera, el resultado sigue visible en la historia y se reintenta el aviso.
    </div>
  </div>

  <!-- Filtros de estado y contadores de alertas -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Pestañas / Filtros -->
        <ul class="nav nav-pills gap-2" id="filtrosNotificaciones">
          <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-1 small fw-semibold <%= filtroActual === 'todas' ? 'active' : 'text-dark bg-light' %>"
               href="/notificaciones?filtro=todas">
              Todas
              <span class="badge <%= filtroActual === 'todas' ? 'bg-white text-primary' : 'bg-secondary text-white' %> rounded-pill ms-1">
                <%= totRegistros %>
              </span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-1 small fw-semibold <%= filtroActual === 'no_leidas' ? 'active' : 'text-dark bg-light' %>"
               href="/notificaciones?filtro=no_leidas">
              No leídas
              <span class="badge <%= filtroActual === 'no_leidas' ? 'bg-white text-primary' : 'bg-primary text-white' %> rounded-pill ms-1" id="badgeFiltroNoLeidas">
                <%= cantNoLeidas %>
              </span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-1 small fw-semibold <%= filtroActual === 'criticas' ? 'active' : 'text-dark bg-light' %>"
               href="/notificaciones?filtro=criticas">
              Críticas
              <span class="badge <%= filtroActual === 'criticas' ? 'bg-white text-danger' : 'bg-danger text-white' %> rounded-pill ms-1">
                <%= cantCriticas %>
              </span>
            </a>
          </li>
        </ul>

        <!-- Conteo de estado rápido -->
        <div class="text-muted small">
          Mostrando página <strong><%= pagActual %></strong> de <strong><%= pagTotales %></strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Listado de notificaciones -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
      <% if (listaNotifs.length === 0) { %>
        <!-- Estado Vacío -->
        <div class="p-5 text-center text-muted" id="estadoVacioListado">
          <div class="mb-3">
            <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary opacity-50">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
          </div>
          <h5 class="fw-bold text-dark">No hay notificaciones para mostrar</h5>
          <p class="small text-muted mb-0">
            <% if (filtroActual === 'no_leidas') { %>
              No tiene alertas ni notificaciones pendientes de revisión.
            <% } else if (filtroActual === 'criticas') { %>
              No hay alertas críticas registradas en este período.
            <% } else { %>
              No se han emitido alertas para su usuario en el sistema.
            <% } %>
          </p>
        </div>
      <% } else { %>
        <!-- Lista de tarjetas de notificación -->
        <div class="list-group list-group-flush" id="contenedorNotificacionesLista">
          <% listaNotifs.forEach(function(item) { %>
            <%
              const esCritica = item.prioridad === 'CRITICA';
              const esLeida = Boolean(item.leido);
              const tieneResultado = Boolean(item.resultado_id);
              const msgLower = (item.mensaje || '').toLowerCase();
              const esLab = msgLower.includes('laboratorio');
              const esRad = msgLower.includes('radiolog');
            %>
            <div class="list-group-item p-3 notif-item <%= !esLeida ? 'no-leida' : '' %> <%= esCritica ? 'prioridad-critica' : '' %>"
                 data-trace="C11-38"
                 data-id="<%= item.id %>"
                 <% if (tieneResultado) { %>data-resultado-id="<%= item.resultado_id %>"<% } %>>
              <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">
                  <!-- [11.39 / 11.47] Ícono de la notificación -->
                  <div class="notif-icono flex-shrink-0 mt-1" data-trace="C11-39">
                    <% if (esLab) { %>
                      <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                        </svg>
                      </div>
                    <% } else if (esRad) { %>
                      <div class="rounded-circle bg-warning-subtle text-warning-emphasis p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    <% } else { %>
                      <div class="rounded-circle bg-info-subtle text-info-emphasis p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;" data-trace="C11-47">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                        </svg>
                      </div>
                    <% } %>
                  </div>

                  <!-- Detalle de la notificación [11.40] -->
                  <div class="flex-grow-1 min-w-0" data-trace="C11-40">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                      <% if (esCritica) { %>
                        <!-- [11.43] Badge Alerta crítica -->
                        <span class="badge bg-danger rounded-pill px-2 py-1 small fw-bold" data-trace="C11-43">
                          Alerta crítica
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                          <%= esLab ? 'Laboratorio' : (esRad ? 'Radiología' : 'Aviso clínico') %>
                        </span>
                      <% } %>

                      <% if (!esLeida) { %>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small fw-semibold notif-badge-estado">
                          No leída
                        </span>
                        <span class="notif-dot bg-primary rounded-circle" title="No leída"></span>
                      <% } else { %>
                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                          Leída
                        </span>
                      <% } %>
                    </div>

                    <!-- Mensaje [11.44 / 11.46 / 11.42] -->
                    <% if (esCritica) { %>
                      <h6 class="fw-bold text-danger mb-1 text-break" data-trace="C11-44" data-trace-c11-42="true">
                        <%= item.mensaje %>
                      </h6>
                      <div class="small text-muted d-flex align-items-center gap-2" data-trace="C11-45">
                        <span class="d-inline-flex align-items-center gap-1">
                          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span class="tiempo-relativo" data-fecha-notif="<%= item.fecha %>" data-trace="C11-41">
                            <%= typeof item.tiempoRelativo !== 'undefined' ? item.tiempoRelativo : 'Reciente' %>
                          </span>
                        </span>
                        <% if (item.fecha) { %>
                          <span class="text-secondary opacity-75">· <%= new Date(item.fecha).toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' }) %></span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <h6 class="fw-semibold text-dark mb-1 text-break" data-trace="C11-46" data-trace-c11-42="true">
                        <%= item.mensaje %>
                      </h6>
                      <div class="small text-muted d-flex align-items-center gap-2" data-trace="C11-48">
                        <span class="d-inline-flex align-items-center gap-1">
                          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span class="tiempo-relativo" data-fecha-notif="<%= item.fecha %>" data-trace="C11-41">
                            <%= typeof item.tiempoRelativo !== 'undefined' ? item.tiempoRelativo : 'Reciente' %>
                          </span>
                        </span>
                        <% if (item.fecha) { %>
                          <span class="text-secondary opacity-75">· <%= new Date(item.fecha).toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' }) %></span>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                </div>

                <!-- Acciones directas por fila -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
                  <% if (tieneResultado) { %>
                    <a href="/resultados/<%= item.resultado_id %>"
                       class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 rounded-pill notif-link-resultado"
                       data-id="<%= item.id %>"
                       data-resultado-id="<%= item.resultado_id %>">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      <span>Ver resultado</span>
                    </a>
                  <% } %>

                  <% if (!esLeida) { %>
                    <button type="button"
                            class="btn btn-light btn-sm text-secondary border rounded-pill d-inline-flex align-items-center gap-1 btn-marcar-leida"
                            data-id="<%= item.id %>"
                            title="Marcar como leída">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span>Marcar leída</span>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Paginación -->
  <% if (pagTotales > 1) { %>
    <nav aria-label="Navegación de notificaciones" class="d-flex justify-content-center">
      <ul class="pagination pagination-sm mb-0">
        <!-- Anterior -->
        <li class="page-item <%= (pagActual <= 1) ? 'disabled' : '' %>">
          <a class="page-link" href="<%= urlPaginaNotif(pagActual - 1) %>" aria-label="Anterior">
            &laquo; Anterior
          </a>
        </li>

        <% for (let p = 1; p <= pagTotales; p++) { %>
          <li class="page-item <%= (p === pagActual) ? 'active' : '' %>">
            <a class="page-link" href="<%= urlPaginaNotif(p) %>"><%= p %></a>
          </li>
        <% } %>

        <!-- Siguiente -->
        <li class="page-item <%= (pagActual >= pagTotales) ? 'disabled' : '' %>">
          <a class="page-link" href="<%= urlPaginaNotif(pagActual + 1) %>" aria-label="Siguiente">
            Siguiente &raquo;
          </a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>

<%- include('../partials/_fin') %>
