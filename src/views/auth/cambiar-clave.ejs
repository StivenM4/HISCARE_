<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>Cambiar contraseña · HISCARE</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css">
  <link rel="stylesheet" href="/css/hiscare.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 p-3">
  <form method="post" action="/auth/cambiar-clave" class="card p-4 shadow-sm" style="width: 100%; max-width: 420px" id="formCambiarClave">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="fs-3 fw-bold text-center mb-2" data-trace="C1-1">HISCARE</div>
    <h2 class="h5 text-center mb-2">Actualizar contraseña</h2>
    <p class="text-muted small text-center mb-3">
      Por seguridad de la plataforma, debe definir una nueva contraseña personal antes de continuar.
    </p>

    <% if (error) { %>
      <div class="alert alert-danger" id="cambiarClaveError" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="mb-3">
      <label for="passwordActual" class="form-label">Contraseña actual (temporal)</label>
      <input type="password" id="passwordActual" name="passwordActual" class="form-control" required autofocus autocomplete="current-password">
    </div>

    <div class="mb-3">
      <label for="passwordNueva" class="form-label">Nueva contraseña</label>
      <input type="password" id="passwordNueva" name="passwordNueva" class="form-control" required minlength="8" autocomplete="new-password">
      <div class="form-text">Mínimo 8 caracteres alfanuméricos.</div>
    </div>

    <button type="submit" class="btn btn-primary w-100" id="btnCambiarClave">
      Guardar contraseña y continuar
    </button>
  </form>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
</body>
</html>
