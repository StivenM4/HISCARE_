<%- include('../partials/_inicio', { titulo: 'Carga de resultados diagnósticos', figuraTrace: 'C24', moduloActivo: 'resultados' }) %>

<%
  const usrSesion = (typeof usuario !== 'undefined' && usuario) ? usuario : null;
  let nombreProfesional = 'Profesional de laboratorio';
  if (usrSesion && usrSesion.nombre) {
    const pref = (usrSesion.rol === 'MEDICO') ? 'Dr(a). ' : ((usrSesion.rol === 'LABORATORIO' || usrSesion.rol === 'ENFERMERO') ? 'Bact. ' : '');
    nombreProfesional = `${pref}${usrSesion.nombre} (sesión activa)`;
  }

  const ahora = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  const fechaHoyIso = `${ahora.getFullYear()}-${pad(ahora.getMonth() + 1)}-${pad(ahora.getDate())}T${pad(ahora.getHours())}:${pad(ahora.getMinutes())}`;
  const ordenPrecargada = (typeof orden !== 'undefined' && orden) ? orden : '';
%>

<style>
  .dropzone-container {
    border: 2px dashed var(--hiscare-border-default, #cbd5e1);
    background-color: var(--hiscare-surface-2, #f8fafc);
    border-radius: 0.5rem;
    transition: all 0.2s ease-in-out;
    outline: none;
  }
  .dropzone-container:hover,
  .dropzone-container:focus,
  .dropzone-container.is-dragover {
    border-color: var(--hiscare-primary-solid, #2563eb);
    background-color: var(--hiscare-primary-subtle-bg, #eff6ff);
  }
  .cursor-pointer {
    cursor: pointer;
  }
</style>

<div class="container-fluid px-0" id="contenedorCargaResultados">
  <!-- Distribución en 2 columnas -->
  <div class="row g-4">
    <!-- Columna Izquierda: [24.15 - 24.29] Encabezado y Orden asociada -->
    <div class="col-12 col-lg-5">
      <!-- [24.15] Encabezado: "Carga de resultados diagnósticos" -->
      <div class="mb-3">
        <h1 class="h4 fw-bold text-dark mb-1" data-trace="C24-15">Carga de resultados diagnósticos</h1>
        <p class="text-muted small mb-0">Recepción y registro de resultados paraclínicos con archivo validado.</p>
      </div>

      <!-- [24.16] Sección / Card "Orden asociada" -->
      <div class="card border-0 shadow-sm rounded-3 mb-4" data-trace="C24-16">
        <div class="card-header bg-white border-bottom py-3">
          <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            <span>Orden asociada</span>
          </h2>
        </div>
        <div class="card-body p-3 p-md-4">
          <!-- [24.17] Input para código de orden con foco automático -->
          <div class="mb-3">
            <label for="codigoOrden" class="form-label small fw-semibold text-secondary text-uppercase mb-1">
              Código de orden
            </label>
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 text-muted" id="addon-orden">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                </svg>
              </span>
              <input type="text"
                     class="form-control border-start-0 ps-0 shadow-none font-monospace"
                     id="codigoOrden"
                     name="codigo"
                     value="<%= ordenPrecargada %>"
                     placeholder="Ej: ORD-89001 (o pistola de código)"
                     aria-label="Código de orden"
                     aria-describedby="addon-orden"
                     autocomplete="off"
                     autofocus
                     data-trace="C24-17">
              <button class="btn btn-outline-primary d-flex align-items-center gap-1" type="button" id="btnBuscarOrden">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <span>Buscar</span>
              </button>
            </div>
            <div class="form-text small text-muted">Presione Enter tras escanear el código de barras o ingresar el código.</div>
          </div>

          <!-- Alerta de búsqueda de orden -->
          <div id="alertaOrden" class="alert alert-warning py-2 px-3 small rounded-3 d-none mb-3" role="alert">
            <span id="mensajeAlertaOrden"></span>
          </div>

          <!-- Datos de la orden (inicialmente vacíos o placeholder hasta buscar) -->
          <div class="border rounded-3 p-3 bg-light bg-opacity-50 mb-3" id="datosOrdenContenedor">
            <div class="row g-2 mb-2">
              <div class="col-12 col-sm-6">
                <span class="text-muted small fw-semibold text-uppercase d-block" data-trace="C24-18">Paciente</span>
                <span class="fw-bold text-dark fs-6 text-break" data-trace="C24-19" id="valPaciente">—</span>
              </div>
              <div class="col-12 col-sm-6">
                <span class="text-muted small fw-semibold text-uppercase d-block" data-trace="C24-20">Médico solicitante</span>
                <span class="fw-bold text-dark fs-6 text-break" data-trace="C24-21" id="valMedico">—</span>
              </div>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <span class="text-muted small fw-semibold text-uppercase d-block" data-trace="C24-22">Tipo</span>
                <span class="fw-semibold text-dark" data-trace="C24-23" id="valTipo">—</span>
              </div>
              <div class="col-6">
                <span class="text-muted small fw-semibold text-uppercase d-block" data-trace="C24-24">Estado</span>
                <span class="badge bg-secondary" data-trace="C24-25" id="valEstado">—</span>
              </div>
            </div>
          </div>

          <!-- [24.26] Tabla de exámenes -->
          <div class="mb-0" data-trace="C24-26">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="small fw-semibold text-secondary text-uppercase">Exámenes de la orden</span>
            </div>
            <div class="table-responsive border rounded-3 bg-white">
              <table class="table table-sm table-hover align-middle mb-0" id="tablaExamenes">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3 py-2 text-uppercase small text-secondary" style="width: 25%;" data-trace="C24-27">CUPS</th>
                    <th class="py-2 text-uppercase small text-secondary" data-trace="C24-28">Examen</th>
                    <th class="pe-3 py-2 text-uppercase small text-secondary text-end" style="width: 15%;" data-trace="C24-29">Cant.</th>
                  </tr>
                </thead>
                <tbody id="tablaExamenesBody">
                  <tr id="filaSinExamenes">
                    <td colspan="3" class="text-center text-muted py-3 small">
                      Ingrese un código de orden para visualizar los exámenes.
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: [24.30 - 24.42] Contenedor / Card "Resultado" -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm rounded-3 mb-4" data-trace="C24-30">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
          <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Resultado</span>
          </h2>
          <span class="badge bg-light text-secondary border fw-normal" id="badgeEstadoOrdenHeader">
            Esperando orden
          </span>
        </div>
        <div class="card-body p-3 p-md-4">
          <!-- Alerta de éxito o error global del resultado -->
          <div id="alertaResultado" class="alert d-none py-2 px-3 small rounded-3 mb-3" role="alert">
            <span id="mensajeAlertaResultado"></span>
          </div>

          <form id="formResultado" novalidate>
            <!-- [24.31] Etiqueta "Informe textual" y [24.32] Textarea informe textual -->
            <div class="mb-3">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                <label for="informeTextual" class="form-label small fw-semibold text-secondary text-uppercase mb-0" data-trace="C24-31">
                  Informe textual
                </label>
                <div class="btn-group btn-group-sm" role="group" aria-label="Simular resultado realizado del paciente">
                  <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="btnSimularLab" title="Autocompletar informe con plantilla clínica de laboratorio realizado">
                    <svg width="12" height="12" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1zm2 1v12h8V2H4z"/></svg>
                    <span>Cargar plantilla Laboratorio realizado</span>
                  </button>
                  <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="btnSimularRx" title="Autocompletar informe con plantilla clínica de imágenes realizada">
                    <svg width="12" height="12" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/><path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/></svg>
                    <span>Cargar plantilla Imágenes realizado</span>
                  </button>
                </div>
              </div>
              <textarea class="form-control shadow-none"
                        id="informeTextual"
                        name="informe"
                        rows="5"
                        placeholder="Escriba aquí los hallazgos, valores de referencia, observaciones paraclínicas o conclusión..."
                        data-trace="C24-32"></textarea>
            </div>

            <!-- [24.33] Etiqueta "Archivo adjunto (PDF, JPG o PNG · máx. 10 MB)" -->
            <div class="mb-3">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <label for="archivoResultado" class="form-label small fw-semibold text-secondary text-uppercase mb-0" data-trace="C24-33">
                  Archivo adjunto (PDF, JPG o PNG · máx. 10 MB)
                </label>
                <!-- [24.35] Badge "VÁLIDO" -->
                <span class="badge bg-success d-none align-items-center gap-1" id="badgeArchivoValido" data-trace="C24-35">
                  <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>VÁLIDO</span>
                </span>
              </div>

              <!-- Input de archivo oculto -->
              <input type="file"
                     id="archivoResultado"
                     name="archivo"
                     class="d-none"
                     accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png">

              <!-- [24.34] Dropzone / selector de archivo con borde punteado -->
              <div class="dropzone-container p-4 text-center cursor-pointer position-relative"
                   id="dropzoneArchivo"
                   role="button"
                   tabindex="0"
                   aria-label="Cargar archivo adjunto"
                   data-trace="C24-34">
                <!-- Estado sin archivo -->
                <div id="dropzoneVacio" class="py-2">
                  <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary mb-2 opacity-75">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                  </svg>
                  <div class="fw-semibold text-dark mb-1">Haga clic o arrastre su archivo aquí</div>
                  <div class="text-muted small">Admite formatos PDF, JPG o PNG hasta 10 MB</div>
                </div>

                <!-- Estado con archivo cargado -->
                <div id="dropzoneConArchivo" class="d-none py-2 d-flex align-items-center justify-content-center gap-3">
                  <div class="rounded-3 p-2 bg-success bg-opacity-10 text-success">
                    <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                  <div class="text-start">
                    <div class="fw-bold text-dark text-break" id="nombreArchivoValido">—</div>
                    <div class="text-muted small" id="tamanoArchivoValido">—</div>
                  </div>
                  <button type="button" class="btn btn-outline-danger btn-sm ms-2" id="btnQuitarArchivo" title="Eliminar archivo">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span class="d-none d-sm-inline ms-1">Quitar</span>
                  </button>
                </div>
              </div>

              <!-- [24.36] Banner / mensaje de error si no cumple formato o tamaño -->
              <div class="alert alert-danger d-none mt-2 py-2 px-3 small rounded-3 d-flex align-items-center gap-2"
                   id="bannerErrorArchivo"
                   role="alert"
                   data-trace="C24-36">
                <svg width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0 text-danger" viewBox="0 0 16 16">
                  <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
                <span id="mensajeErrorArchivo"></span>
              </div>
            </div>

            <!-- Fila de metadatos: [24.37, 24.38] Profesional responsable y [24.39, 24.40] Fecha del resultado -->
            <div class="row g-3 mb-4">
              <div class="col-12 col-sm-6">
                <label for="profesionalResponsable" class="form-label small fw-semibold text-secondary text-uppercase mb-1" data-trace="C24-37">
                  Profesional responsable
                </label>
                <input type="text"
                       class="form-control bg-light shadow-none"
                       id="profesionalResponsable"
                       name="profesional"
                       value="<%= nombreProfesional %>"
                       readonly
                       data-trace="C24-38">
              </div>
              <div class="col-12 col-sm-6">
                <label for="fechaResultado" class="form-label small fw-semibold text-secondary text-uppercase mb-1" data-trace="C24-39">
                  Fecha del resultado
                </label>
                <input type="datetime-local"
                       class="form-control shadow-none"
                       id="fechaResultado"
                       name="fecha_resultado"
                       value="<%= fechaHoyIso %>"
                       max="<%= fechaHoyIso %>"
                       data-trace="C24-40">
              </div>
            </div>

            <!-- Botones de acción: [24.41] Cancelar y [24.42] Cargar resultado y notificar -->
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 pt-3 border-top">
              <button type="button"
                      class="btn btn-outline-secondary px-4 shadow-sm"
                      id="btnCancelar"
                      data-trace="C24-41">
                Cancelar
              </button>
              <button type="submit"
                      class="btn btn-primary px-4 d-inline-flex align-items-center gap-2 shadow-sm"
                      id="btnCargarResultado"
                      data-trace="C24-42">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Cargar resultado y notificar</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/_fin', { scripts: ['/js/carga_resultado.js'] }) %>
