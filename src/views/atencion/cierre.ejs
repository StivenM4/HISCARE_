<%- include('../partials/_inicio', { titulo: 'Cierre de atención', figuraTrace: 'C22' }) %>
<!-- Cierre inmutable con sello SHA-256 y adendas -->
<%- include('../partials/_banner_paciente', { figuraTrace: 'C22', seccion: 'cierre' }) %>
<%- include('../partials/_tabs_atencion', { figuraTrace: 'C22', seccion: 'cierre' }) %>

<%
  const idAtencion = atencion.id;
  const esCerrada = (atencion.estado === 'CERRADA');
  const esAdmin = Boolean(typeof usuario !== 'undefined' && usuario && usuario.rol === 'ADMINISTRADOR');
  const esMedicoTitularVal = (typeof esMedicoTitular !== 'undefined' ? esMedicoTitular : Boolean(usuario && usuario.id === atencion.medico_id)) || esAdmin;

  // Extracción de reglas de checklist
  const check = (typeof checklist !== 'undefined' && checklist) ? checklist : { puedeCerrar: false, reglas: [] };
  const reglasArray = Array.isArray(check.reglas) ? check.reglas : [];

  const rMotivoSignos = reglasArray.find(r => r.regla === 'motivo_signos') || {
    cumple: Boolean(check.motivo_signos),
    enlace: `/atenciones/${idAtencion}/consulta`,
    detalle: 'Motivo de consulta y signos vitales registrados'
  };

  const rEvolucion = reglasArray.find(r => r.regla === 'evolucion_medica') || {
    cumple: Boolean(check.evolucion_medica),
    enlace: `/atenciones/${idAtencion}/evolucion`,
    detalle: 'Evolución médica SOAP registrada y firmada'
  };

  const rDiagnostico = reglasArray.find(r => r.regla === 'diagnostico_principal') || {
    cumple: Boolean(check.diagnostico_principal),
    enlace: `/atenciones/${idAtencion}/diagnosticos`,
    codigo: check.diagnostico_principal_codigo || null,
    detalle: 'Diagnóstico principal codificado (CIE-10)'
  };

  const rConsentimientos = reglasArray.find(r => r.regla === 'consentimientos_firmados') || {
    cumple: Boolean(check.consentimientos_firmados),
    enlace: `/atenciones/${idAtencion}/consentimientos`,
    detalle: 'Consentimientos informados firmados'
  };

  const rNotaAlta = reglasArray.find(r => r.regla === 'nota_alta') || {
    cumple: Boolean(check.nota_alta),
    enlace: `/atenciones/${idAtencion}/alta`,
    detalle: 'Nota de alta médica (epicrisis)'
  };

  // Código y descripción del diagnóstico principal
  const codDiag = rDiagnostico.codigo || check.diagnostico_principal_codigo || null;
  const textoDiagPpal = codDiag ? `(${codDiag})` : '';

  // Formato del médico tratante que cierra la atención
  let medicoNombreVal = atencion.medico_nombre || (typeof usuario !== 'undefined' && usuario ? usuario.nombre : '') || 'Médico tratante';
  if (medicoNombreVal && medicoNombreVal !== 'Médico tratante' && !medicoNombreVal.toLowerCase().startsWith('dr.') && !medicoNombreVal.toLowerCase().startsWith('dra.')) {
    medicoNombreVal = (medicoNombreVal.toLowerCase().includes('ana') || medicoNombreVal.toLowerCase().includes('diana') || medicoNombreVal.toLowerCase().includes('laura'))
      ? `Dra. ${medicoNombreVal}`
      : `Dr. ${medicoNombreVal}`;
  }

  // Fecha y hora de cierre
  const fechaCierreVal = atencion.fecha_cierre_formateada || (atencion.fecha_cierre ? String(atencion.fecha_cierre) : 'Pendiente de cierre');

  // Huella SHA-256 completa y abreviada
  const huellaCompleta = atencion.firma_hash || '';
  function formatearHuellaAbreviada(hash) {
    if (!hash) return 'Pendiente de sello SHA-256';
    if (hash.length <= 24) return hash;
    return `${hash.slice(0, 1)}...${hash.slice(1, 15)}...${hash.slice(-3)}`;
  }
  const huellaAbreviada = huellaCompleta ? formatearHuellaAbreviada(huellaCompleta) : 'Pendiente de sello SHA-256';

  // Lista de adendas históricas
  const listaAdendas = (typeof adendas !== 'undefined' && Array.isArray(adendas)) ? adendas : [];
%>

<div class="container-fluid px-0"
     id="contenedorCierre"
     data-atencion-id="<%= idAtencion %>"
     data-estado="<%= atencion.estado %>"
     data-es-titular="<%= esMedicoTitularVal ? 'true' : 'false' %>"
     data-puede-cerrar="<%= check.puedeCerrar ? 'true' : 'false' %>">

  <!-- Mensajes y alertas del sistema -->
  <div id="contenedorAlertasCierre"></div>

  <!-- Retorno Post-Cierre (Evitar callejón sin salida) -->
  <% if (esCerrada) { %>
    <div class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-4 bg-light rounded border border-light-subtle gap-2" id="barraRetornoSuperior">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success">Atención Cerrada</span>
        <span class="small text-muted">Esta atención médica ha concluido y se encuentra sellada criptográficamente.</span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <a href="/agenda" class="btn btn-outline-primary btn-sm">Volver a la agenda médica</a>
        <a href="/atenciones" class="btn btn-outline-secondary btn-sm">Listado de atenciones</a>
      </div>
    </div>
  <% } %>

  <!-- Layout Bootstrap 5 de 2 columnas responsivas: Lista de verificación a la izq., Adendas a la dcha. -->
  <div class="row g-4">

    <!-- ======================================================== -->
    <!-- Columna Izquierda (col-lg-5): Checklist y Sello SHA-256   -->
    <!-- ======================================================== -->
    <div class="col-12 col-lg-5">

      <!-- [22.27] Card: Lista de verificación para el cierre -->
      <div class="card shadow-sm border-0 bg-white p-4 mb-4" style="border-radius: 0.5rem;" data-trace="C22-27" id="cardChecklist">
        
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h5 class="fw-bold text-dark fs-6 mb-0 d-flex align-items-center gap-2">
            <svg width="18" height="18" fill="currentColor" class="bi bi-card-checklist text-primary" viewBox="0 0 16 16">
              <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h13zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-13z"/>
              <path d="M7 5.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0zM7 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0zm0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0zM7 13.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
            </svg>
            Lista de verificación para el cierre
          </h5>
          <span class="badge <%= check.puedeCerrar ? 'bg-success bg-opacity-10 text-success border border-success border-opacity-25' : 'bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25' %> small" id="badgeEstadoChecklist">
            <%= check.puedeCerrar ? 'Requisitos completos' : 'Requisitos pendientes' %>
          </span>
        </div>

        <p class="small text-muted mb-3">
          Verifique que los registros clínicos obligatorios estén diligenciados antes de proceder al cierre inmutable:
        </p>

        <!-- Lista de 5 requisitos con íconos verde/rojo y enlaces a las pestañas correspondientes -->
        <ul class="list-group list-group-flush mb-4" id="listaChecklist">

          <!-- [22.28] Motivo de consulta y signos vitales registrados -->
          <li class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0 border-bottom" data-trace="C22-28" id="itemChecklistMotivo">
            <div class="d-flex align-items-center gap-2">
              <span class="icono-estado flex-shrink-0" id="iconoMotivo">
                <% if (rMotivoSignos.cumple) { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                <% } else { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-x-circle-fill text-danger" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                  </svg>
                <% } %>
              </span>
              <span class="small fw-medium text-dark">Motivo de consulta y signos vitales registrados</span>
            </div>
            <a href="/atenciones/<%= idAtencion %>/consulta" class="btn btn-outline-secondary btn-sm px-2 py-0 small text-decoration-none" title="Ir a Consulta">
              Ver
            </a>
          </li>

          <!-- [22.29] Evolución SOAP firmada -->
          <li class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0 border-bottom" data-trace="C22-29" id="itemChecklistEvolucion">
            <div class="d-flex align-items-center gap-2">
              <span class="icono-estado flex-shrink-0" id="iconoEvolucion">
                <% if (rEvolucion.cumple) { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                <% } else { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-x-circle-fill text-danger" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                  </svg>
                <% } %>
              </span>
              <span class="small fw-medium text-dark">Evolución SOAP firmada</span>
            </div>
            <a href="/atenciones/<%= idAtencion %>/evolucion" class="btn btn-outline-secondary btn-sm px-2 py-0 small text-decoration-none" title="Ir a Evolución SOAP">
              Ver
            </a>
          </li>

          <!-- [22.30] Un diagnóstico CIE-10 principal -->
          <li class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0 border-bottom" data-trace="C22-30" id="itemChecklistDiagnostico">
            <div class="d-flex align-items-center gap-2">
              <span class="icono-estado flex-shrink-0" id="iconoDiagnostico">
                <% if (rDiagnostico.cumple) { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                <% } else { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-x-circle-fill text-danger" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                  </svg>
                <% } %>
              </span>
              <span class="small fw-medium text-dark">
                Un diagnóstico CIE-10 principal
                <% if (textoDiagPpal) { %>
                  <span class="badge bg-light text-primary font-monospace ms-1 border" id="badgeDiagChecklist"><%= textoDiagPpal %></span>
                <% } %>
              </span>
            </div>
            <a href="/atenciones/<%= idAtencion %>/diagnosticos" class="btn btn-outline-secondary btn-sm px-2 py-0 small text-decoration-none" title="Ir a Diagnósticos">
              Ver
            </a>
          </li>

          <!-- [22.31] Consentimientos firmados -->
          <li class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0 border-bottom" data-trace="C22-31" id="itemChecklistConsentimientos">
            <div class="d-flex align-items-center gap-2">
              <span class="icono-estado flex-shrink-0" id="iconoConsentimientos">
                <% if (rConsentimientos.cumple) { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                <% } else { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-x-circle-fill text-danger" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                  </svg>
                <% } %>
              </span>
              <span class="small fw-medium text-dark">Consentimientos firmados</span>
            </div>
            <a href="/atenciones/<%= idAtencion %>/consentimientos" class="btn btn-outline-secondary btn-sm px-2 py-0 small text-decoration-none" title="Ir a Consentimientos">
              Ver
            </a>
          </li>

          <!-- [22.32] Nota de alta registrada -->
          <li class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0" data-trace="C22-32" id="itemChecklistNotaAlta">
            <div class="d-flex align-items-center gap-2">
              <span class="icono-estado flex-shrink-0" id="iconoNotaAlta">
                <% if (rNotaAlta.cumple) { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                <% } else { %>
                  <svg width="18" height="18" fill="currentColor" class="bi bi-x-circle-fill text-danger" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                  </svg>
                <% } %>
              </span>
              <span class="small fw-medium text-dark">Nota de alta registrada</span>
            </div>
            <a href="/atenciones/<%= idAtencion %>/alta" class="btn btn-outline-secondary btn-sm px-2 py-0 small text-decoration-none" title="Ir a Nota de alta">
              Ver
            </a>
          </li>

        </ul>

        <% if (!esCerrada) { %>
          <!-- Botón de acción para cerrar atención (Atención ABIERTA) -->
          <div class="pt-3 border-top mt-auto">
            <button type="button"
                    class="btn btn-danger w-100 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2"
                    id="btnCerrarAtencion" <%= (!check.puedeCerrar || (!esMedicoTitularVal && !(typeof usuario !== 'undefined' && usuario && usuario.rol === 'ADMINISTRADOR'))) ? 'disabled' : '' %>>
              <svg width="18" height="18" fill="currentColor" class="bi bi-lock-fill" viewBox="0 0 16 16">
                <path d="M8 1a2 2 0 0 0-2 2v4H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1V3a2 2 0 0 0-2-2zm-1 2a1 1 0 0 1 2 0v4H7V3z"/>
              </svg>
              <span>Cerrar atención</span>
            </button>
            <% if (!esMedicoTitularVal && !(typeof usuario !== 'undefined' && usuario && usuario.rol === 'ADMINISTRADOR')) { %>
              <div class="form-text small text-danger mt-1 text-center">
                Solo el médico titular tratante puede efectuar el cierre definitivo.
              </div>
            <% } else if (!check.puedeCerrar) { %>
              <div class="form-text small text-muted mt-1 text-center">
                Debe completar las 4 reglas bloqueantes para habilitar el cierre.
              </div>
            <% } %>
          </div>
        <% } %>

      </div>

      <% if (esCerrada) { %>
        <!-- [22.33] Sección/Card: Sello de la atención (Atención CERRADA) -->
        <div class="card shadow-sm border-0 bg-white p-4 mb-4" style="border-radius: 0.5rem;" data-trace="C22-33" id="cardSelloAtencion">
          
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h5 class="fw-bold text-dark fs-6 mb-0 d-flex align-items-center gap-2">
              <svg width="18" height="18" fill="currentColor" class="bi bi-shield-check text-success" viewBox="0 0 16 16">
                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.464 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
              </svg>
              Sello de la atención
            </h5>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
              Inmutable (SHA-256)
            </span>
          </div>

          <!-- Metadatos del sello criptográfico -->
          <div class="mb-3">
            <div class="text-secondary small fw-semibold mb-1" data-trace="C22-34">Cerrada por</div>
            <div class="small fw-semibold text-dark p-2 bg-light rounded border border-light-subtle d-flex align-items-center gap-2" data-trace="C22-35" id="valorCerradaPor">
              <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span><%= medicoNombreVal %></span>
            </div>
          </div>

          <div class="mb-3">
            <div class="text-secondary small fw-semibold mb-1" data-trace="C22-36">Fecha de cierre</div>
            <div class="small text-dark p-2 bg-light rounded border border-light-subtle font-monospace d-flex align-items-center gap-2" data-trace="C22-37" id="valorFechaCierre">
              <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span><%= fechaCierreVal %></span>
            </div>
          </div>

          <div class="mb-3">
            <div class="text-secondary small fw-semibold mb-1">Huella SHA-256</div>
            <div class="p-2 bg-light rounded border border-light-subtle d-flex align-items-center justify-content-between gap-2"
                 data-trace="C22-38"
                 id="valorHuellaSha"
                 title="<%= huellaCompleta %>"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top">
              <span class="small font-monospace text-truncate text-primary fw-semibold" id="textoHuellaAbreviada">
                <%= huellaAbreviada %>
              </span>
              <button type="button" class="btn btn-link btn-sm p-0 text-muted" id="btnCopiarHuella" title="Copiar huella completa">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </button>
            </div>
            <div class="form-text small text-muted">Huella criptográfica de 64 caracteres generada por trigger PostgreSQL.</div>
          </div>

          <!-- [22.39] Botón Verificar integridad -->
          <div class="pt-2">
            <button type="button"
                    class="btn btn-outline-secondary btn-sm w-100 py-2 d-inline-flex align-items-center justify-content-center gap-2 fw-medium"
                    id="btnVerificarIntegridad"
                    data-trace="C22-39">
              <span class="spinner-border spinner-border-sm d-none" id="spinnerVerificar" role="status" aria-hidden="true"></span>
              <svg width="16" height="16" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16" id="iconoVerificar">
                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.464 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                <path d="M9.5 6.5e-3a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 5 8.006v-4A1.5 1.5 0 0 1 6.5 2.506v-1A1.5 1.5 0 0 1 8 .006h1.5zM8 1.006a.5.5 0 0 0-.5.5v1h2v-1a.5.5 0 0 0-.5-.5H8z"/>
              </svg>
              <span>Verificar integridad</span>
            </button>
          </div>

          <!-- Contenedor dinámico de resultado de verificación criptográfica -->
          <div id="resultadoVerificacion" class="mt-3"></div>

        </div>

        <!-- [22.40] Banner verde: Registro sellado -->
        <div class="alert alert-success border-0 shadow-sm py-2 px-3 mb-3 d-flex align-items-center gap-2"
             data-trace="C22-40"
             id="bannerRegistroSellado"
             role="alert">
          <svg width="18" height="18" fill="currentColor" class="bi bi-lock-fill text-success flex-shrink-0" viewBox="0 0 16 16">
            <path d="M8 1a2 2 0 0 0-2 2v4H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1V3a2 2 0 0 0-2-2zm-1 2a1 1 0 0 1 2 0v4H7V3z"/>
          </svg>
          <span class="small text-dark fw-medium">
            🔒 Registro sellado: diagnósticos, evoluciones, procedimientos y nota de alta quedan en solo lectura
          </span>
        </div>

        <!-- [22.41] Banner rojo/aviso: Intento de edición bloqueado -->
        <div class="alert alert-danger bg-opacity-10 text-danger border-0 shadow-sm py-2 px-3 mb-3 d-flex align-items-center gap-2"
             data-trace="C22-41"
             id="bannerEdicionBloqueada"
             role="alert">
          <svg width="18" height="18" fill="currentColor" class="bi bi-slash-circle-fill text-danger flex-shrink-0" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-4.646-2.646a.5.5 0 0 0-.708-.708l-6 6a.5.5 0 0 0 .708.708l6-6z"/>
          </svg>
          <span class="small fw-medium">
            ⛔ Intento de edición bloqueado: la atención está cerrada. Solo se permite agregar una adenda
          </span>
        </div>
      <% } %>

    </div>

    <!-- ======================================================== -->
    <!-- Columna Derecha (col-lg-7): Adendas aclaratorias         -->
    <!-- ======================================================== -->
    <div class="col-12 col-lg-7">
      
      <!-- [22.42] Card: Adendas aclaratorias -->
      <div class="card shadow-sm border-0 bg-white p-4 h-100 d-flex flex-column" style="border-radius: 0.5rem;" data-trace="C22-42" id="cardAdendas">

        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h5 class="fw-bold text-dark fs-6 mb-0 d-flex align-items-center gap-2">
            <svg width="18" height="18" fill="currentColor" class="bi bi-journal-text text-primary" viewBox="0 0 16 16">
              <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
              <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
              <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
            </svg>
            Adendas aclaratorias
          </h5>
          <span class="badge bg-light text-secondary border small" id="badgeConteoAdendas">
            <span id="numAdendas"><%= listaAdendas.length %></span> adenda(s)
          </span>
        </div>

        <p class="small text-muted mb-3">
          Historial de adendas cronológicas inmutables incorporadas con posterioridad al cierre de la atención:
        </p>

        <!-- [22.43] Tabla de adendas históricas -->
        <div class="table-responsive mb-4 flex-grow-1">
          <table class="table table-hover align-middle mb-0" id="tablaAdendas" data-trace="C22-43">
            <thead class="table-light">
              <tr>
                <!-- [22.44] Columna Fecha y hora -->
                <th scope="col" class="text-secondary small fw-semibold" style="width: 25%;" data-trace="C22-44">Fecha y hora</th>
                <!-- [22.45] Columna Autor -->
                <th scope="col" class="text-secondary small fw-semibold" style="width: 25%;" data-trace="C22-45">Autor</th>
                <!-- [22.46] Columna Texto -->
                <th scope="col" class="text-secondary small fw-semibold" style="width: 50%;" data-trace="C22-46">Texto</th>
              </tr>
            </thead>
            <tbody id="adendasBody">
              <% if (listaAdendas.length > 0) { %>
                <% listaAdendas.forEach((adenda) => { %>
                  <tr>
                    <td data-label="Fecha y hora" class="small font-monospace text-nowrap"><%= adenda.fecha_formateada || adenda.fecha %></td>
                    <td data-label="Autor" class="small fw-semibold text-nowrap"><%= adenda.autor_nombre || 'Médico tratante' %></td>
                    <td data-label="Texto" class="small text-break"><%= adenda.texto %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr id="filaSinAdendas">
                  <td colspan="3" class="text-center text-muted py-4 small">
                    No hay adendas registradas para esta atención.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <% if (esCerrada) { %>
          <!-- Sección para agregar nueva adenda (Atención CERRADA) -->
          <div class="border-top pt-3 mt-auto" id="seccionNuevaAdenda">

            <!-- [22.47] Título/Sección "Nueva adenda" -->
            <h6 class="fw-bold text-dark fs-6 mb-2" data-trace="C22-47">
              Nueva adenda
            </h6>

            <!-- [22.48] Textarea para nueva adenda con contador de caracteres -->
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="textoNuevaAdenda" class="form-label text-secondary small fw-semibold mb-0">
                  Contenido aclaratorio de la adenda
                </label>
                <span class="small text-muted" id="contadorCaracteresAdenda">
                  <span id="conteoCaracteresAdenda" class="text-danger fw-bold">0</span> / 10 mín. (máx. 2000)
                </span>
              </div>
              <textarea class="form-control shadow-none"
                        id="textoNuevaAdenda"
                        name="texto"
                        rows="4"
                        maxlength="2000"
                        placeholder="Resultado de glucosa en suero (RES-...654) revisado: 92 mg/dL. Se ajusta plan farmacológico ambulatorio..."
                        data-trace="C22-48"></textarea>
              <div class="form-text small text-muted">
                Longitud mínima requerida: 10 caracteres (máximo 2000).
              </div>
            </div>

            <!-- [22.49] Aviso legal informativo -->
            <div class="alert alert-light border border-secondary-subtle py-2 px-3 mb-3 d-flex align-items-center gap-2 small text-secondary"
                 data-trace="C22-49"
                 id="avisoLegalAdenda"
                 role="note">
              <svg width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill text-primary flex-shrink-0" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
              </svg>
              <span>ℹ La adenda no modifica el registro original; se guarda aparte con autor, fecha y hora.</span>
            </div>

            <!-- [22.50] Botón Agregar adenda -->
            <div class="d-flex justify-content-end">
              <button type="button"
                      class="btn btn-primary btn-sm px-3 py-2 fw-medium d-inline-flex align-items-center gap-2"
                      id="btnAgregarAdenda"
                      data-trace="C22-50">
                <span class="spinner-border spinner-border-sm d-none" id="spinnerAdenda" role="status" aria-hidden="true"></span>
                <span>Agregar adenda</span>
              </button>
            </div>

          </div>
        <% } else { %>
          <!-- Mensaje de aviso cuando la atención está ABIERTA -->
          <div class="alert alert-info border border-info-subtle py-3 px-3 small d-flex align-items-center gap-2 mt-auto" id="avisoAdendasSoloCerrada">
            <svg width="18" height="18" fill="currentColor" class="bi bi-info-circle-fill text-info flex-shrink-0" viewBox="0 0 16 16">
              <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
            </svg>
            <span>ℹ Las adendas aclaratorias solo aplican a atenciones cerradas. Una vez cerrada la atención clínica, se habilitará el formulario para registrar adendas inmutables.</span>
          </div>
        <% } %>

      </div>

    </div>

  </div>

  <!-- Barra de navegación de salida / retorno post-cierre -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top gap-2" id="barraRetornoInferior">
    <div class="small text-muted">HISCARE · Cierre inmutable de atención clínica</div>
    <div class="d-flex align-items-center gap-2">
      <a href="/agenda" class="btn btn-outline-primary btn-sm">Volver a la agenda médica</a>
      <a href="/atenciones" class="btn btn-outline-secondary btn-sm">Listado de atenciones</a>
    </div>
  </div>

</div>

<!-- Modal Bootstrap de Confirmación de Cierre Definitivo -->
<% if (!esCerrada) { %>
<div class="modal fade" id="modalConfirmarCierre" tabindex="-1" aria-labelledby="modalConfirmarCierreLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark fs-6" id="modalConfirmarCierreLabel">Confirmar cierre de atención</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body py-3">
        <div class="d-flex gap-3 align-items-start">
          <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-circle flex-shrink-0">
            <svg width="24" height="24" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
              <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.464 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
              <path d="M9.5 6.5e-3a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 5 8.006v-4A1.5 1.5 0 0 1 6.5 2.506v-1A1.5 1.5 0 0 1 8 .006h1.5zM8 1.006a.5.5 0 0 0-.5.5v1h2v-1a.5.5 0 0 0-.5-.5H8z"/>
            </svg>
          </div>
          <div>
            <p class="mb-2 fw-semibold text-dark">
              Esta acción es irreversible y aplicará el sello criptográfico SHA-256. La atención quedará en modo solo lectura.
            </p>
            <p class="small text-muted mb-0">
              Una vez sellada, los diagnósticos, evoluciones y procedimientos no podrán ser editados; cualquier aclaración posterior deberá registrarse como adenda.
            </p>
          </div>
        </div>
      </div>
      <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-2" id="btnConfirmarCerrar">
          <span class="spinner-border spinner-border-sm d-none" id="spinnerModalCerrar" role="status" aria-hidden="true"></span>
          <span>Confirmar y cerrar atención</span>
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Datos iniciales serializados para hidratación y testing -->
<script id="datosInicialesCierre" type="application/json">
<%- JSON.stringify({
  atencionId: idAtencion,
  estado: atencion.estado,
  esCerrada,
  esMedicoTitular: esMedicoTitularVal,
  puedeCerrar: check.puedeCerrar,
  checklist: check,
  firmaHash: huellaCompleta,
  fechaCierre: fechaCierreVal,
  medicoNombre: medicoNombreVal,
  adendas: listaAdendas
}).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>
</script>

<%- include('../partials/_fin', { scripts: ['/js/cierre.js'] }) %>
