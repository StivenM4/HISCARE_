<%- include('../partials/_inicio', { titulo: 'Antecedentes' }) %>
<!-- Atención clínica · Antecedentes -->
<%- include('../partials/_banner_paciente') %>
<%- include('../partials/_tabs_atencion') %>

<%
  const idHistoria = (typeof historiaId !== 'undefined' && historiaId) ? historiaId : (atencion.historia_id || (typeof historia_id !== 'undefined' ? historia_id : ''));
  const sexoPaciente = atencion.sexo || atencion.paciente_sexo || (typeof paciente !== 'undefined' && paciente && paciente.sexo) || 'M';
  const esMujer = (sexoPaciente === 'F' || sexoPaciente === 'Femenino');
  const puedeModificar = (typeof soloLectura !== 'undefined' ? !soloLectura : true) && (typeof puedeEditar !== 'undefined' ? puedeEditar : true);

  // Agrupación flexible de antecedentes (acepta antecedentesAgrupados u objeto/array plano antecedentes)
  const agrupados = {
    Patologico: [],
    Quirurgico: [],
    Alergico: [],
    Farmacologico: [],
    Familiar: [],
    Ginecologico: []
  };

  const fuente = (typeof antecedentesAgrupados !== 'undefined' && antecedentesAgrupados)
    ? antecedentesAgrupados
    : ((typeof antecedentes !== 'undefined' && antecedentes) ? antecedentes : null);

  if (fuente) {
    if (Array.isArray(fuente)) {
      fuente.forEach(a => {
        if (a && a.tipo && Array.isArray(agrupados[a.tipo])) {
          agrupados[a.tipo].push(a);
        }
      });
    } else if (typeof fuente === 'object') {
      Object.keys(agrupados).forEach(tipo => {
        if (Array.isArray(fuente[tipo])) {
          agrupados[tipo] = fuente[tipo];
        }
      });
    }
  }

  function formatearFecha(f) {
    if (!f) return '';
    if (typeof f === 'string' && f.includes('/')) return f;
    try {
      const d = new Date(f);
      if (isNaN(d.getTime())) return String(f);
      const dia = String(d.getDate()).padStart(2, '0');
      const mes = String(d.getMonth() + 1).padStart(2, '0');
      const anio = d.getFullYear();
      return `${dia}/${mes}/${anio}`;
    } catch (e) {
      return String(f);
    }
  }

  function parsearAntecedenteAlergico(desc) {
    if (!desc) return { sustancia: '', reaccion: '', anio: '', tieneFormato: false };
    const raw = String(desc).trim();
    const sepMatch = raw.match(/\s*[-–—]\s*/);
    if (!sepMatch) {
      return { sustancia: raw, reaccion: '', anio: '', tieneFormato: false };
    }
    const sustancia = raw.substring(0, sepMatch.index).trim();
    const resto = raw.substring(sepMatch.index + sepMatch[0].length).trim();
    const anioMatch = resto.match(/\s*\(([^)]+)\)$/);
    let reaccion = resto;
    let anio = '';
    if (anioMatch) {
      anio = anioMatch[1].trim();
      reaccion = resto.substring(0, anioMatch.index).trim();
    }
    return { sustancia, reaccion, anio, tieneFormato: Boolean(reaccion) };
  }
%>

<!-- [C5-48] Alerta informativa fija de advertencia sobre alergias en el encabezado -->
<div class="alert alert-warning d-flex align-items-center gap-2 mb-3 py-2 px-3 small border-0 shadow-sm" data-trace="C5-48">
  <svg width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0" viewBox="0 0 16 16">
    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
  </svg>
  <span><strong>Las alergias registradas aquí se muestran en el encabezado de todas las pantallas de la atención.</strong></span>
</div>

<!-- Contenedor principal de la pestaña de antecedentes -->
<div id="antecedentesContainer"
     class="antecedentes-vista mb-4"
     data-atencion="<%= atencion.id %>"
     data-historia="<%= idHistoria %>"
     data-solo-lectura="<%= !puedeModificar ? 'true' : 'false' %>">

  <!-- Cuadrícula de tarjetas responsiva -->
  <div class="row g-3">

    <!-- [C5-28 a C5-31] Tarjeta Patológicos -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm border-0 bg-white" style="border-radius: 0.5rem;">
        <div class="card-header bg-transparent border-0 pt-3 px-3 pb-2 d-flex align-items-center justify-content-between">
          <h6 class="fw-bold mb-0 text-dark" data-trace="C5-28">Patológicos</h6>
          <% if (puedeModificar) { %>
            <button type="button"
                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 btn-agregar-antecedente"
                    data-tipo="Patologico"
                    data-tipo-label="Patológico"
                    data-trace="C5-31">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
              </svg>
              <span>Agregar antecedente</span>
            </button>
          <% } %>
        </div>
        <div class="card-body px-3 py-2 antecedentes-scroll-body">
          <ul class="list-unstyled mb-0 lista-antecedentes" id="lista-Patologico" style="max-height: 220px; overflow-y: auto;">
            <% if (agrupados.Patologico.length > 0) { %>
              <% agrupados.Patologico.forEach((a, idx) => { %>
                <li class="mb-2 d-flex align-items-start gap-2" <%- idx === 0 ? 'data-trace="C5-29"' : (idx === 1 ? 'data-trace="C5-30"' : '') %>>
                  <span class="text-primary mt-1">•</span>
                  <div>
                    <span class="fw-medium text-dark"><%= a.descripcion %></span>
                    <% if (a.fecha_creacion || a.fecha) { %>
                      <span class="text-muted small ms-1">(<%= formatearFecha(a.fecha_creacion || a.fecha) %>)</span>
                    <% } %>
                  </div>
                </li>
              <% }) %>
              <% if (agrupados.Patologico.length === 1) { %>
                <span class="d-none" data-trace="C5-30"></span>
              <% } %>
            <% } else { %>
              <li class="text-muted small fst-italic sin-antecedentes" data-trace="C5-29">
                <span>Sin antecedentes registrados</span>
                <span class="d-none" data-trace="C5-30"></span>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </div>

    <!-- [C5-32 a C5-35] Tarjeta Quirúrgicos -->
    <div class="col-12 col-md-6 col-lg-4">
