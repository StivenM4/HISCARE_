                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
              </svg>
              <span>Agregar antecedente</span>
            </button>
          <% } %>
        </div>
        <div class="card-body px-3 py-2 antecedentes-scroll-body">
          <ul class="list-unstyled mb-0 lista-antecedentes" id="lista-Quirurgico" style="max-height: 220px; overflow-y: auto;">
            <% if (agrupados.Quirurgico.length > 0) { %>
              <% agrupados.Quirurgico.forEach((a, idx) => { %>
