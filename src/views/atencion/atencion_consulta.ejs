<%- include('../partials/_inicio', { titulo: 'Consulta' }) %>
<!-- Atención clínica · Consulta y signos vitales -->
<%- include('../partials/_banner_paciente') %>
<%- include('../partials/_tabs_atencion') %>

<%
  const hcCodigo = atencion.hc_codigo || atencion.historia_codigo || (atencion.historia_id ? 'HC-' + atencion.historia_id.slice(0, 8) : 'HC-000123');
  const horaBorrador = atencion.borrador_hora || ((atencion.borrador && atencion.borrador.fecha) ? new Date(atencion.borrador.fecha).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', hour12: false }) : '');
  const textoBorradorServidor = (atencion.borrador && atencion.borrador.contenido && atencion.borrador.contenido.texto)
    ? atencion.borrador.contenido.texto
    : (atencion.borrador && atencion.borrador.texto ? atencion.borrador.texto : '');
  const valorMotivoInicial = atencion.motivo_consulta != null ? atencion.motivo_consulta : textoBorradorServidor;
%>

<div class="row g-4" id="consulta" data-atencion="<%= atencion.id %>" data-solo-lectura="<%= soloLectura ? 'true' : 'false' %>">
  <!-- Columna Izquierda: Motivo de consulta y enfermedad actual -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 bg-white p-3 h-100" style="border-radius: 0.5rem;">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <label for="motivo" class="form-label fw-bold fs-6 text-dark mb-0" data-trace="C4-30">
          Motivo de consulta y enfermedad actual
        </label>
        <% if (!soloLectura) { %>
          <button id="btnGuardarMotivo"
                  type="button"
                  class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-1 shadow-sm"
                  data-trace="C4-29">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M11 2H9v3h2V2z"/>
              <path d="M1.5 0h11.793a1 1 0 0 1 .707.293l1.707 1.707A1 1 0 0 1 16 2.707V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0zM1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v3.5A1.5 1.5 0 0 1 11.5 6h-7A1.5 1.5 0 0 1 3 4.5V1H1.5a.5.5 0 0 0-.5.5z"/>
            </svg>
            <span>Guardar</span>
          </button>
        <% } else { %>
          <button id="btnGuardarMotivo"
                  type="button"
                  class="btn btn-secondary d-none"
                  data-trace="C4-29"
                  disabled>
            Guardar
          </button>
        <% } %>
      </div>

      <div class="mb-3 flex-grow-1 d-flex flex-column">
        <textarea id="motivo"
                  name="motivo_consulta"
                  class="form-control flex-grow-1 shadow-none"
                  rows="9"
                  placeholder="Describa el motivo de consulta, síntomas principales, tiempo de evolución y antecedentes pertinentes..."
                  data-borrador="motivo"
                  data-borrador-servidor="<%= textoBorradorServidor %>"
                  data-trace="C4-31"
                  <%= soloLectura ? 'disabled' : '' %>><%= valorMotivoInicial %></textarea>
        <div class="invalid-feedback">Por favor ingrese un motivo de consulta válido (mínimo 5 caracteres).</div>
      </div>

      <!-- Callout de borrador automático [4.32] -->
      <div class="alert alert-info py-2 px-3 mt-auto d-flex align-items-center gap-2 mb-0 border-0 text-info-emphasis"
           id="indicadorBorrador"
           data-trace="C4-32"
           data-hc="<%= hcCodigo %>"
           style="background-color: #f0f7ff; color: #075985; font-size: 0.85rem;">
        <svg width="16" height="16" fill="currentColor" class="flex-shrink-0" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
        </svg>
        <span id="textoBorrador">
          ℹ Borrador guardado automáticamente <%= horaBorrador ? 'a las ' + horaBorrador : 'a las --:--' %> · Historia clínica <%= hcCodigo %> abierta en esta atención
        </span>
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Signos vitales [4.33] -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 bg-white p-3" data-trace="C4-33" id="cardSignosVitales" style="border-radius: 0.5rem;">
      <h3 class="fs-6 fw-bold text-dark mb-3">Signos vitales</h3>
      
      <form id="formSignos" novalidate>
        <!-- TA sistólica y diastólica [4.34, 4.35] -->
        <div class="row align-items-center mb-2">
          <label class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-34">TA (mmHg)</label>
          <div class="col-7" data-trace="C4-35">
            <div class="input-group input-group-sm">
              <input type="number"
                     name="presion_sistolica"
                     id="presion_sistolica"
                     class="form-control text-center"
                     placeholder="120"
                     min="40" max="300"
                     aria-label="Tensión arterial sistólica"
                     <%= soloLectura ? 'disabled' : '' %>>
              <span class="input-group-text px-1 bg-light border-start-0 border-end-0">/</span>
              <input type="number"
                     name="presion_diastolica"
                     id="presion_diastolica"
                     class="form-control text-center"
                     placeholder="80"
                     min="20" max="200"
                     aria-label="Tensión arterial diastólica"
                     <%= soloLectura ? 'disabled' : '' %>>
            </div>
          </div>
        </div>

        <!-- FC [4.36, 4.37] -->
        <div class="row align-items-center mb-2">
          <label for="frecuencia_cardiaca" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-36">FC (lpm)</label>
          <div class="col-7">
            <input type="number"
                   name="frecuencia_cardiaca"
                   id="frecuencia_cardiaca"
                   class="form-control form-control-sm text-end"
                   placeholder="78"
                   min="20" max="300"
                   data-trace="C4-37"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- FR [4.38, 4.39] -->
        <div class="row align-items-center mb-2">
          <label for="frecuencia_respiratoria" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-38">FR (rpm)</label>
          <div class="col-7">
            <input type="number"
                   name="frecuencia_respiratoria"
                   id="frecuencia_respiratoria"
                   class="form-control form-control-sm text-end"
                   placeholder="18"
                   min="4" max="80"
                   data-trace="C4-39"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- Temp [4.40, 4.41] -->
        <div class="row align-items-center mb-2">
          <label for="temperatura_celsius" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-40">Temp (°C)</label>
          <div class="col-7">
            <input type="number"
                   name="temperatura_celsius"
                   id="temperatura_celsius"
                   class="form-control form-control-sm text-end"
                   placeholder="36.5"
                   step="0.1"
                   min="30" max="45"
                   data-trace="C4-41"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- SpO2 [4.42, 4.43] -->
        <div class="row align-items-center mb-2">
          <label for="saturacion_oxigeno" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-42">SpO2 (%)</label>
          <div class="col-7">
            <input type="number"
                   name="saturacion_oxigeno"
                   id="saturacion_oxigeno"
                   class="form-control form-control-sm text-end"
                   placeholder="98"
                   min="0" max="100"
                   data-trace="C4-43"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- Peso [4.44, 4.45] -->
        <div class="row align-items-center mb-2">
          <label for="peso_kg" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-44">Peso (kg)</label>
          <div class="col-7">
            <input type="number"
                   name="peso_kg"
                   id="peso_kg"
                   class="form-control form-control-sm text-end"
                   placeholder="81.5"
                   step="0.01"
                   min="0.3" max="500"
                   data-trace="C4-45"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- Talla [4.46, 4.47] -->
        <div class="row align-items-center mb-2">
          <label for="talla_cm" class="col-5 col-form-label col-form-label-sm text-secondary" data-trace="C4-46">Talla (cm)</label>
          <div class="col-7">
            <input type="number"
                   name="talla_cm"
                   id="talla_cm"
                   class="form-control form-control-sm text-end"
                   placeholder="178"
                   step="0.01"
                   min="20" max="260"
                   data-trace="C4-47"
                   <%= soloLectura ? 'disabled' : '' %>>
          </div>
        </div>

        <!-- IMC Vista previa (solo lectura, calculado) [4.48, 4.49] -->
        <div class="row align-items-center mb-3">
          <label for="imcPrevio" class="col-5 col-form-label col-form-label-sm text-secondary fw-semibold" data-trace="C4-48">IMC</label>
          <div class="col-7">
            <input type="text"
                   id="imcPrevio"
                   class="form-control form-control-sm text-end bg-light fw-bold text-primary"
                   placeholder="Calculado"
                   readonly
                   data-trace="C4-49">
          </div>
        </div>

        <%
          const initTriage = atencion.triage || atencion.nivel_triage || atencion.triage_nivel || null;
          let initTriageClase = 'badge-triage-5';
          let initTriageLabel = 'Triage V · Consulta Externa';
          if (initTriage) {
            const s = String(initTriage).toUpperCase();
            if (s === '1' || s === 'I' || s.includes('REANIM')) { initTriageClase = 'badge-triage-1'; initTriageLabel = 'Triage I · Reanimación'; }
            else if (s === '2' || s === 'II' || s.includes('EMERG')) { initTriageClase = 'badge-triage-2'; initTriageLabel = 'Triage II · Emergencia'; }
            else if (s === '3' || s === 'III' || s.includes('URGEN')) { initTriageClase = 'badge-triage-3'; initTriageLabel = 'Triage III · Urgencia'; }
            else if (s === '4' || s === 'IV' || s.includes('PRIOR')) { initTriageClase = 'badge-triage-4'; initTriageLabel = 'Triage IV · Prioritario'; }
          }
        %>
        <!-- Indicador de vista previa de clasificación de Triage sugerido por signos vitales -->
        <div class="row align-items-center mb-3">
          <label class="col-5 col-form-label col-form-label-sm text-secondary fw-semibold">Triage sugerido</label>
          <div class="col-7 d-flex justify-content-end">
            <span class="badge badge-triage <%= initTriageClase %>"
                  id="triagePrevioBadge"
                  title="Clasificación de Triage sugerida por signos vitales">
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="7"/>
              </svg>
              <span><%= initTriageLabel %></span>
            </span>
          </div>
        </div>

        <% if (!soloLectura) { %>
          <div class="d-flex justify-content-end mb-3">
            <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-semibold" id="btnRegistrarSignos">
              Registrar signos
            </button>
          </div>
        <% } else { %>
          <div class="d-none">
            <button type="submit" id="btnRegistrarSignos" disabled>Registrar signos</button>
          </div>
        <% } %>
      </form>

      <!-- Tabla de tomas anteriores de la atención -->
      <div class="border-top pt-2">
        <h4 class="small fw-semibold text-muted d-block mb-1">Tomas registradas en esta atención</h4>
        <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
          <table class="table table-sm table-striped align-middle text-center small mb-0" id="tablaSignos">
            <thead class="table-light">
              <tr class="text-secondary small">
                <th>Hora</th>
                <th>TA</th>
                <th>FC</th>
                <th>FR</th>
                <th>T°</th>
                <th>SpO2</th>
                <th>Peso</th>
                <th>Talla</th>
                <th>IMC</th>
              </tr>
            </thead>
            <tbody id="tomas">
              <% if (atencion.tomas && atencion.tomas.length > 0) { %>
                <% atencion.tomas.forEach(t => { %>
                  <tr>
                    <td><%= t.hora || '--:--' %></td>
                    <td><%= (t.presion_sistolica && t.presion_diastolica) ? (t.presion_sistolica + '/' + t.presion_diastolica) : '-' %></td>
                    <td><%= t.frecuencia_cardiaca || '-' %></td>
                    <td><%= t.frecuencia_respiratoria || '-' %></td>
                    <td><%= t.temperatura_celsius || '-' %></td>
                    <td><%= t.saturacion_oxigeno || '-' %></td>
                    <td><%= t.peso_kg || '-' %></td>
                    <td><%= t.talla_cm || '-' %></td>
                    <td><span class="badge bg-light text-primary border"><%= t.imc || '-' %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr id="filaSinTomas">
                  <td colspan="9" class="text-muted py-2">Sin signos vitales registrados</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/_fin', { scripts: ['/js/borrador.js', '/js/atencion_consulta.js'] }) %>
