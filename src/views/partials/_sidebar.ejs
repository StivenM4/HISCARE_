<%
  const pfxSidebar = (typeof figuraTrace !== 'undefined' && (figuraTrace === 'C7' || figuraTrace === 'C10' || figuraTrace === 'C21' || figuraTrace === 'C22' || figuraTrace === 'C23' || figuraTrace === 'C24' || figuraTrace === 'C25'))
    ? figuraTrace
    : ((typeof locals !== 'undefined' && locals.pfxSidebar) ? locals.pfxSidebar : 'C2');

  const esC23 = (pfxSidebar === 'C23');
  const esC24 = (pfxSidebar === 'C24');
  const esC25 = (pfxSidebar === 'C25');

  const traceMap = (esC23 || esC24 || esC25) ? {
    inicio: pfxSidebar + '-2',
    agenda: pfxSidebar + '-3',
    pacientes: pfxSidebar + '-4',
    atenciones: pfxSidebar + '-5',
    ordenes: pfxSidebar + '-6',
    resultados: pfxSidebar + '-7',
    auditoria: pfxSidebar + '-8',
    admin: pfxSidebar + '-9'
  } : {
    inicio: pfxSidebar + '-3',
    agenda: pfxSidebar + '-4',
    pacientes: pfxSidebar + '-5',
    atenciones: pfxSidebar + '-6',
    ordenes: pfxSidebar + '-7',
    resultados: pfxSidebar + '-8',
    auditoria: pfxSidebar + '-9',
    admin: pfxSidebar + '-10'
  };

  const iconMap = {
    inicio: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>',
    agenda: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>',
    pacientes: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
    atenciones: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-3-3v6m-9 5h18a2 2 0 002-2V6a2 2 0 00-2-2H3a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>',
    ordenes: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>',
    resultados: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>',
    auditoria: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
    admin: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>'
  };

  const items = (typeof menu !== 'undefined' && Array.isArray(menu)) ? menu : [];
  const ruta = typeof rutaActual !== 'undefined' ? rutaActual : '';
  const modAct = typeof moduloActivo !== 'undefined' ? moduloActivo : '';
%>

<nav class="sidebar d-flex flex-column flex-shrink-0 p-3" id="sidebarMenu" role="navigation" aria-label="Menú principal del sistema" <%- (esC23 || esC24 || esC25) ? '' : `data-trace="${pfxSidebar}-2"` %>>
  <div class="sidebar-brand-wrapper mb-4 pb-2 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
    <a href="/" class="d-flex align-items-center gap-2 text-white text-decoration-none" data-trace="<%= pfxSidebar %>-1" aria-label="HISCARE - Ir al inicio del sistema">
      <span class="brand-logo-icon text-primary" aria-hidden="true">
        <svg width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 0a1 1 0 0 1 1 1v6h6a1 1 0 1 1 0 2H9v6a1 1 0 1 1-2 0V9H1a1 1 0 1 1 0-2h6V1a1 1 0 0 1 1-1z"/>
        </svg>
      </span>
      <span class="brand-logo-text fw-bold fs-4 tracking-tight">HISCARE</span>
    </a>
    <button type="button" class="btn-close btn-close-white" id="btnCerrarSidebar" aria-label="Cerrar menú lateral" title="Cerrar menú lateral"></button>
  </div>

  <ul class="nav nav-pills flex-column mb-auto sidebar-menu gap-1" role="menubar" aria-label="Módulos de HISCARE">
    <% items.forEach(m => { %>
      <%
        const trace = traceMap[m.clave] || ('C2-' + m.clave);
        const icon = m.icono || iconMap[m.clave] || '';
        const isCurrent = (m.ruta === '/' && (ruta === '/' || ruta === '/inicio' || modAct === 'inicio')) ||
                          (m.ruta !== '/' && ruta.startsWith(m.ruta)) ||
                          (modAct === m.clave);
      %>
      <li class="nav-item" role="none">
        <a href="<%= m.ruta %>"
           class="nav-link sidebar-link d-flex align-items-center gap-3 <%= isCurrent ? 'active' : '' %>"
           data-trace="<%= trace %>"
           role="menuitem"
           aria-label="<%= m.nombre %>"
           aria-current="<%= isCurrent ? 'page' : 'false' %>">
          <span class="nav-icon"><%- icon %></span>
          <span class="nav-text"><%= m.nombre %></span>
        </a>
      </li>
    <% }); %>
  </ul>
</nav>
