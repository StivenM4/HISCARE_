<%
  const esC23 = (typeof figuraTrace !== 'undefined' && figuraTrace === 'C23');
  const esC24 = (typeof figuraTrace !== 'undefined' && figuraTrace === 'C24');
  const esC25 = (typeof figuraTrace !== 'undefined' && figuraTrace === 'C25');
  const pfxTopTrace = (typeof figuraTrace !== 'undefined' && (figuraTrace === 'C7' || figuraTrace === 'C10' || figuraTrace === 'C11' || figuraTrace === 'C21' || figuraTrace === 'C22' || figuraTrace === 'C23' || figuraTrace === 'C24' || figuraTrace === 'C25')) ? figuraTrace : 'C2';
  const traceBuscar = (esC23 || esC24 || esC25) ? `${pfxTopTrace}-10` : `${pfxTopTrace}-11`;
  const traceCampana = (esC23 || esC24 || esC25) ? `${pfxTopTrace}-11` : `${pfxTopTrace}-12`;
  const traceAvatar = (esC23 || esC24 || esC25) ? `${pfxTopTrace}-12` : `${pfxTopTrace}-13`;
  const traceInfoUsuario = (esC23 || esC24 || esC25) ? `${pfxTopTrace}-13` : `${pfxTopTrace}-14`;
  const traceSalir = (esC23 || esC24 || esC25) ? `${pfxTopTrace}-14` : (pfxTopTrace === 'C22' ? 'C22-15' : 'C2-15');
%>
<header class="topbar d-flex align-items-center justify-content-between px-2 px-sm-3 px-md-4 py-2 bg-white border-bottom shadow-sm" role="banner" aria-label="Barra superior de navegación clínica">
  <!-- Botón de apertura/colapso de menú lateral (visible en escritorio y móvil) -->
  <button class="btn btn-light me-2 d-inline-flex align-items-center justify-content-center p-0 rounded-2 text-secondary border shadow-none"
          id="btnToggleSidebar"
          type="button"
          aria-label="Alternar menú de navegación"
          aria-expanded="false"
          aria-controls="sidebarMenu"
          style="width: 40px; height: 40px; min-width: 40px;">
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Buscador global con ícono de lupa y placeholder "Buscar pacientes, órdenes...", con contenedor dropdown -->
  <div class="search-global-wrapper position-relative flex-grow-1 me-2 me-md-4" style="max-width: 480px;">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0 text-muted" id="search-addon" aria-hidden="true">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </span>
      <input type="search"
             id="buscarGlobal"
             class="form-control border-start-0 ps-0 shadow-none"
             placeholder="Buscar pacientes, órdenes..."
             aria-label="Buscar pacientes, órdenes y registros clínicos"
             aria-describedby="search-addon"
             autocomplete="off"
             data-trace="<%= traceBuscar %>">
    </div>
    <!-- Contenedor dropdown de resultados -->
    <div id="buscarDropdown" class="dropdown-menu w-100 shadow-lg p-0 mt-1 border-0 rounded-3 d-none position-absolute" role="region" aria-label="Resultados de búsqueda global" style="z-index: 1050; max-height: 380px; overflow-y: auto;">
      <div id="buscarResultados" class="p-2">
        <!-- Rellenado dinámicamente por topbar.js -->
      </div>
    </div>
  </div>

  <!-- Contenedor de usuario y controles superiores -->
  <div class="d-flex align-items-center gap-2 gap-sm-3 ms-auto topbar-actions">
    <!-- Botón de cambio de tema (Claro / Oscuro) -->
    <button type="button"
            id="btnToggleTheme"
            class="btn rounded-circle p-0 position-relative d-inline-flex align-items-center justify-content-center topbar-theme-btn"
            style="width: 40px; height: 40px; min-width: 40px;"
            aria-label="Modo oscuro"
            aria-pressed="false"
            title="Cambiar a modo oscuro">
      <svg data-theme-icon="moon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
      <svg data-theme-icon="sun" class="d-none" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
    </button>

    <!-- C2-12 / C11-11 / C23-11: Campana de avisos con badge y dropdown de notificaciones recientes -->
    <div class="dropdown position-relative" id="contenedorNotificaciones" data-trace="<%= traceCampana %>">
      <span class="d-none" data-trace="C2-12" aria-hidden="true"></span>
      <button class="btn btn-light rounded-circle p-0 position-relative d-inline-flex align-items-center justify-content-center text-muted dropdown-toggle no-caret"
              id="btnCampana"
              type="button"
              data-bs-toggle="dropdown"
              data-bs-auto-close="outside"
              aria-expanded="false"
              title="Avisos y notificaciones clínicas"
              aria-label="Avisos y notificaciones clínicas"
              data-trace="<%= (esC23 || esC24 || esC25) ? (pfxTopTrace + '-11') : 'C11-11' %>"
              style="width: 40px; height: 40px; min-width: 40px;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notifCount" aria-label="Notificaciones no leídas" hidden>
          0
        </span>
      </button>
      <%- include('_notificaciones') %>
    </div>

    <!-- Separador -->
    <div class="vr my-2 text-muted opacity-25 d-none d-sm-block" aria-hidden="true"></div>

    <!-- Perfil de usuario -->
    <div class="d-flex align-items-center gap-2 user-profile">
      <%
        const usr = (typeof usuario !== 'undefined' && usuario) ? usuario : null;
        const nombreUsr = usr ? (usr.nombre || 'Usuario') : 'Usuario';
        const rolUsr = usr ? (usr.rol || '') : '';
        const iniciales = nombreUsr.split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();
      %>
      <!-- Avatar del usuario (ícono circular o estilizado) -->
      <div class="user-avatar rounded-circle d-flex align-items-center justify-content-center bg-primary text-white fw-bold shadow-sm"
           data-trace="<%= traceAvatar %>"
           role="img"
           aria-label="Avatar de <%= nombreUsr %>"
           style="width: 38px; height: 38px; font-size: 14px;"
           title="<%= nombreUsr %>">
        <span><%= iniciales %></span>
      </div>

      <!-- Nombre del usuario y rol -->
      <div class="user-info text-start d-none d-sm-block lh-sm" data-trace="<%= traceInfoUsuario %>">
        <div class="fw-semibold text-dark user-name text-truncate" style="max-width: 170px;"><%= nombreUsr %></div>
        <small class="text-muted user-role d-block text-capitalize"><%= rolUsr ? rolUsr.toLowerCase() : '' %></small>
      </div>
    </div>

    <!-- Separador -->
    <div class="vr my-2 text-muted opacity-25 d-none d-sm-block" aria-hidden="true"></div>

    <!-- Botón Salir (formulario POST /auth/logout con botón e icono de cerrar sesión) -->
    <form method="post" action="/auth/logout" class="m-0 d-inline-flex align-items-center" aria-label="Cerrar sesión">
      <button type="submit"
              class="btn btn-outline-danger d-inline-flex align-items-center justify-content-center rounded-circle p-0"
              title="Cerrar sesión"
              aria-label="Cerrar sesión de <%= nombreUsr %>"
              data-trace="<%= traceSalir %>"
              style="width: 40px; height: 40px; min-width: 40px;">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span class="visually-hidden">Salir</span>
      </button>
    </form>
  </div>
</header>
