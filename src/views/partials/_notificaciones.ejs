<!-- Desplegable de notificaciones médicas recientes -->
<div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-0 mt-2"
     id="dropdownNotificaciones"
     aria-labelledby="btnCampana"
     style="width: 380px; max-width: 92vw; z-index: var(--z-popover, 1060);">

  <!-- [11.37] Cabecera y [11.51] Botón marcar todas como leídas -->
  <div class="d-flex align-items-center justify-content-between p-3 border-bottom bg-light rounded-top">
    <div class="d-flex align-items-center gap-2">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary flex-shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
      </svg>
      <h6 class="mb-0 fw-bold text-dark small" data-trace="C11-37">Notificaciones médicas recientes</h6>
    </div>
    <button type="button"
            class="btn btn-link btn-sm p-0 text-decoration-none small text-primary fw-semibold"
            id="btnMarcarTodasLeidasDropdown"
            data-trace="C11-51">
      Marcar todas como leídas
    </button>
  </div>

  <!-- [11.38] Lista dinámica de notificaciones médicas -->
  <div id="notificacionesLista" class="list-group list-group-flush" style="max-height: 380px; overflow-y: auto;">
    <%
      const itemsDropdown = (typeof notificacionesRecientes !== 'undefined' && Array.isArray(notificacionesRecientes))
        ? notificacionesRecientes
        : ((typeof notificaciones !== 'undefined' && Array.isArray(notificaciones)) ? notificaciones.slice(0, 5) : []);
    %>
    <% if (itemsDropdown.length > 0) { %>
      <% itemsDropdown.forEach(function(item) { %>
        <%
          const esCritica = item.prioridad === 'CRITICA';
          const esLeida = Boolean(item.leido);
          const tieneResultado = Boolean(item.resultado_id);
          const msgLower = (item.mensaje || '').toLowerCase();
          const esLab = msgLower.includes('laboratorio');
          const esRad = msgLower.includes('radiolog');
        %>
        <div class="list-group-item list-group-item-action p-3 notif-item <%= !esLeida ? 'no-leida' : '' %> <%= esCritica ? 'prioridad-critica' : '' %>"
             data-trace="C11-38"
             data-id="<%= item.id %>"
             <% if (tieneResultado) { %>data-resultado-id="<%= item.resultado_id %>"<% } %>
             style="cursor: pointer;">
          <div class="d-flex align-items-start gap-2">
            <!-- [11.39 / 11.47] Ícono según tipo -->
            <div class="notif-icono flex-shrink-0 mt-1" data-trace="C11-39">
              <% if (esLab) { %>
                <span class="badge bg-primary-subtle text-primary p-2 rounded-circle d-inline-flex align-items-center justify-content-center">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                  </svg>
                </span>
              <% } else if (esRad) { %>
                <span class="badge bg-warning-subtle text-warning-emphasis p-2 rounded-circle d-inline-flex align-items-center justify-content-center">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </span>
              <% } else { %>
                <span class="badge bg-info-subtle text-info-emphasis p-2 rounded-circle d-inline-flex align-items-center justify-content-center" data-trace="C11-47">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                  </svg>
                </span>
              <% } %>
            </div>

            <!-- Contenido del mensaje -->
            <div class="flex-grow-1 min-w-0" data-trace="C11-40">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <% if (esCritica) { %>
                  <!-- [11.43] Alerta crítica badge rojo -->
                  <span class="badge bg-danger text-white rounded-pill px-2 py-0 small fw-bold" data-trace="C11-43">
                    Alerta crítica
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-0 small">
                    Aviso clínico
                  </span>
                <% } %>
                <!-- Indicador de no leído -->
                <% if (!esLeida) { %>
                  <span class="notif-dot bg-primary rounded-circle" title="No leída" style="width: 8px; height: 8px; display: inline-block;"></span>
                <% } %>
              </div>

              <!-- [11.44 / 11.46 / 11.42] Detalle del mensaje -->
              <% if (esCritica) { %>
                <p class="mb-1 small fw-semibold text-danger text-break notif-texto" data-trace="C11-44" data-trace-c11-42="true">
                  <%= item.mensaje %>
                </p>
                <!-- [11.45 / 11.41] Tiempo relativo -->
                <div class="small text-muted d-flex align-items-center gap-1" data-trace="C11-45">
                  <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="tiempo-relativo" data-fecha-notif="<%= item.fecha %>" data-trace="C11-41">
                    <%= typeof item.tiempoRelativo !== 'undefined' ? item.tiempoRelativo : 'Reciente' %>
                  </span>
                </div>
              <% } else { %>
                <p class="mb-1 small text-dark text-break notif-texto" data-trace="C11-46" data-trace-c11-42="true">
                  <%= item.mensaje %>
                </p>
                <!-- [11.48 / 11.41] Tiempo relativo -->
                <div class="small text-muted d-flex align-items-center gap-1" data-trace="C11-48">
                  <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="tiempo-relativo" data-fecha-notif="<%= item.fecha %>" data-trace="C11-41">
                    <%= typeof item.tiempoRelativo !== 'undefined' ? item.tiempoRelativo : 'Reciente' %>
                  </span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Estado vacío (visible si no hay notificaciones) -->
  <div id="notificacionesVacio" class="p-4 text-center text-muted <%= (itemsDropdown.length > 0) ? 'd-none' : '' %>">
    <div class="mb-2">
      <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary opacity-50">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
      </svg>
    </div>
    <div class="small fw-semibold text-dark">No hay notificaciones recientes</div>
    <div class="small text-muted" style="font-size: 0.78rem;">Todos los avisos clínicos están al día</div>
  </div>

  <!-- [11.49] Texto informativo -->
  <div class="p-2 px-3 bg-light border-top border-bottom small text-muted d-flex align-items-center gap-2"
       data-trace="C11-49"
       style="font-size: 0.76rem; line-height: 1.35;">
    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-info flex-shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>Si una notificación no se genera, el resultado sigue visible en la historia y se reintenta el aviso</span>
  </div>

  <!-- [11.50] Enlace Ver todo -->
  <div class="p-2 text-center bg-white rounded-bottom">
    <a href="/notificaciones" class="btn btn-sm btn-outline-primary w-100 fw-semibold" data-trace="C11-50">
      Ver todo
    </a>
  </div>
</div>
