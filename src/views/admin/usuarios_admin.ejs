<%- include('../partials/_inicio', { titulo: 'Administración de usuarios y roles' }) %>
<!-- Administración de usuarios, roles y matriz de permisos -->

<div class="container-fluid px-0" id="adminUsuariosApp" data-usuario-actual-id="<%= typeof usuario !== 'undefined' && usuario ? usuario.id : '' %>" data-usuario-actual-email="<%= typeof usuario !== 'undefined' && usuario ? usuario.email : '' %>">

  <!-- Encabezado y Sub-navegación superior del módulo [12.15] -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Administración de usuarios y roles</h1>
      <p class="text-muted small mb-0">Gestión de cuentas institucionales, control de acceso RBAC y verificación de permisos.</p>
    </div>
  </div>

  <div class="mb-4 border-bottom pb-2">
    <ul class="nav nav-pills gap-2" role="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link active bg-primary text-white fw-semibold shadow-sm" href="/admin/usuarios" data-trace="C12-15">
          Usuarios
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link text-secondary bg-white border" href="/admin/especialidades" data-trace="C12-15-esp">
          Especialidades
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link text-secondary bg-white border" href="/admin/aseguradoras" data-trace="C12-15-aseg">
          Aseguradoras
        </a>
      </li>
    </ul>
  </div>

  <!-- Barra de control y filtros [12.16 - 12.22] -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 p-md-4">
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-5 col-lg-4">
          <label for="buscarUsuarioInput" class="form-label small fw-semibold text-secondary" data-trace="C12-16">Buscar usuario</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
              </svg>
            </span>
            <input type="text"
                   id="buscarUsuarioInput"
                   class="form-control border-start-0"
                   placeholder="Nombre o correo institucional"
                   data-trace="C12-17"
                   autocomplete="off">
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
          <label for="filtroRolSelect" class="form-label small fw-semibold text-secondary" data-trace="C12-18">Rol</label>
          <select id="filtroRolSelect" class="form-select" data-trace="C12-19">
            <option value="">Todos</option>
          </select>
        </div>

        <div class="col-12 col-sm-6 col-md-2 col-lg-2">
          <label for="filtroEstadoSelect" class="form-label small fw-semibold text-secondary" data-trace="C12-20">Estado</label>
          <select id="filtroEstadoSelect" class="form-select" data-trace="C12-21">
            <option value="todos">Todos</option>
            <option value="true" selected>Activos</option>
            <option value="false">Inactivos</option>
          </select>
        </div>

        <div class="col-12 col-md-2 col-lg-3 text-md-end">
          <button type="button"
                  id="btnNuevoUsuario"
                  class="btn btn-primary w-100 w-md-auto d-inline-flex align-items-center justify-content-center gap-1 shadow-sm"
                  data-trace="C12-22">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
              <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4 1 1 1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
              <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5"/>
            </svg>
            <span>Nuevo usuario</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Layout del módulo de administración de usuarios -->
  <div class="row g-4 mb-4">
    <!-- Panel Directorio de Usuarios al ancho completo [12.23 - 12.33] -->
    <div class="col-12">
      <!-- Sección colapsable: Matriz de permisos por rol [12.34 - 12.42] -->
      <div class="collapse mb-4" id="seccionMatrizPermisos">
        <div class="card border-0 shadow-sm rounded-3" data-trace="C12-35">
          <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-shield-lock-fill text-primary" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5"/>
              </svg>
              <h2 class="h6 fw-bold text-dark mb-0" data-trace="C12-34">Matriz de permisos por rol</h2>
            </div>
            <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#seccionMatrizPermisos" aria-label="Cerrar matriz"></button>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-bordered text-center align-middle mb-0" id="tablaMatrizPermisos" style="font-size: 0.825rem;">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="text-start ps-3 py-2 text-secondary fw-semibold">Módulo</th>
                    <th scope="col" class="py-2 text-secondary fw-semibold" style="width: 14%;" data-trace="C12-37" title="Médico">MED</th>
                    <th scope="col" class="py-2 text-secondary fw-semibold" style="width: 14%;" data-trace="C12-38" title="Recepcionista">REC</th>
                    <th scope="col" class="py-2 text-secondary fw-semibold" style="width: 14%;" data-trace="C12-39" title="Enfermero">ENF</th>
                    <th scope="col" class="py-2 text-secondary fw-semibold" style="width: 14%;" data-trace="C12-40" title="Auditor">AUD</th>
                    <th scope="col" class="py-2 text-secondary fw-semibold" style="width: 14%;" data-trace="C12-41" title="Administrador">ADM</th>
                  </tr>
                </thead>
                <tbody id="cuerpoMatrizPermisos">
                  <!-- Filas de módulos y permisos -->
                  <tr data-modulo="pacientes">
                    <td class="text-start ps-3 fw-semibold text-dark" data-trace="C12-36">Pacientes</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="agenda">
                    <td class="text-start ps-3 fw-semibold text-dark">Agenda y citas</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="atenciones">
                    <td class="text-start ps-3 fw-semibold text-dark">Atención clínica</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="historias">
                    <td class="text-start ps-3 fw-semibold text-dark">Historia clínica</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-bold">L/E*</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="ordenes">
                    <td class="text-start ps-3 fw-semibold text-dark">Órdenes</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="resultados">
                    <td class="text-start ps-3 fw-semibold text-dark">Resultados</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="auditoria">
                    <td class="text-start ps-3 fw-semibold text-dark">Auditoría</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="badge bg-light text-dark border">L</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                  <tr data-modulo="admin">
                    <td class="text-start ps-3 fw-semibold text-dark">Administración</td>
                    <td class="permiso-celda" data-rol="MEDICO"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="RECEPCIONISTA"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ENFERMERO"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="AUDITOR"><span class="text-muted">—</span></td>
                    <td class="permiso-celda" data-rol="ADMINISTRADOR"><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">L/E</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card-footer bg-light border-top p-3">
            <p class="small text-muted mb-0" data-trace="C12-42" style="font-size: 0.785rem; line-height: 1.4;">
              <strong>L</strong> = lectura &middot; <strong>E</strong> = escritura &middot; <strong>*</strong> solo signos vitales. Cada ruta Express valida esta matriz en el middleware <code>autorizar()</code>; si falla responde HTTP 403.
            </p>
          </div>
        </div>
      </div>

      <!-- Tarjeta Directorio de Usuarios [12.23] -->
      <div class="card border-0 shadow-sm rounded-3 h-100 hc-tabla-card" data-trace="C12-23">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-2">
            <h2 class="h6 fw-bold text-dark mb-0">Directorio de usuarios</h2>
            <span class="badge bg-light text-secondary border" id="totalUsuariosBadge">0 usuarios</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#seccionMatrizPermisos" aria-expanded="false" aria-controls="seccionMatrizPermisos">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-lock-fill text-primary" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5"/>
              </svg>
              <span>Matriz de permisos por rol</span>
            </button>
            <div class="spinner-border spinner-border-sm text-primary d-none" id="loaderUsuarios" role="status">
              <span class="visually-hidden">Cargando...</span>
            </div>
          </div>
        </div>

        <div class="card-body p-0 hc-tabla-body">
          <div class="hc-tabla-contenedor">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" id="tablaUsuarios">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="small text-secondary fw-semibold ps-3" data-trace="C12-24">Nombre</th>
                    <th scope="col" class="small text-secondary fw-semibold" data-trace="C12-25">Correo institucional</th>
                    <th scope="col" class="small text-secondary fw-semibold" data-trace="C12-26">Rol</th>
                    <th scope="col" class="small text-secondary fw-semibold" data-trace="C12-27">Especialidades</th>
                    <th scope="col" class="small text-secondary fw-semibold" data-trace="C12-28">Estado</th>
                    <th scope="col" class="small text-secondary fw-semibold text-end pe-3" data-trace="C12-29" data-orderable="false">Acciones</th>
                  </tr>
                </thead>
                <tbody id="cuerpoTablaUsuarios">
                  <!-- Filas renderizadas dinámicamente con JavaScript -->
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                      <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                      Cargando directorio de usuarios...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Paginación dinámica -->
        <div class="card-footer bg-white border-top py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div class="small text-muted" id="textoPaginacion">
            Mostrando registros
          </div>
          <nav aria-label="Navegación de usuarios">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item" id="itemPaginaAnterior">
                <button class="page-link" type="button" id="btnPaginaAnterior" aria-label="Anterior">
                  &laquo; Anterior
                </button>
              </li>
              <li class="page-item active" id="itemPaginaActual">
                <span class="page-link bg-primary text-white border-primary" id="spanPaginaActual">1</span>
              </li>
              <li class="page-item" id="itemPaginaSiguiente">
                <button class="page-link" type="button" id="btnPaginaSiguiente" aria-label="Siguiente">
                  Siguiente &raquo;
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Creación / Edición [12.43 - 12.53] -->
  <div class="modal fade" id="modalUsuario" tabindex="-1" aria-labelledby="modalUsuarioTitulo" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-bottom py-3">
          <h5 class="modal-title fw-bold text-dark" id="modalUsuarioTitulo" data-trace="C12-43">Nuevo usuario</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>

        <form id="formUsuario" novalidate>
          <input type="hidden" id="usuarioIdInput" value="">

          <div class="modal-body p-4">
            <!-- Contenedor para feedback y errores de validación -->
            <div id="alertaModalUsuario" class="alert alert-danger py-2 small mb-3 d-none" role="alert"></div>

            <div class="mb-3">
              <label for="usuarioNombreInput" class="form-label small fw-semibold text-secondary" data-trace="C12-44">
                Nombre completo <span class="text-danger">*</span>
              </label>
              <input type="text"
                     class="form-control"
                     id="usuarioNombreInput"
                     placeholder="Ej. Ana Pérez Gómez"
                     data-trace="C12-45"
                     required
                     maxlength="150"
                     autocomplete="name">
              <div class="invalid-feedback">Ingrese el nombre completo del usuario.</div>
            </div>

            <div class="mb-3">
              <label for="usuarioEmailInput" class="form-label small fw-semibold text-secondary" data-trace="C12-46">
                Correo institucional <span class="text-danger">*</span>
              </label>
              <input type="email"
                     class="form-control font-monospace"
                     id="usuarioEmailInput"
                     placeholder="ejemplo@hiscare.edu.co"
                     data-trace="C12-47"
                     required
                     maxlength="150"
                     autocomplete="email">
              <div class="invalid-feedback">Ingrese un correo institucional válido (@hiscare.edu.co).</div>
              <div class="form-text small text-muted">Debe pertenecer al dominio institucional (@hiscare.edu.co).</div>
            </div>

            <div class="mb-3">
              <label for="usuarioRolSelect" class="form-label small fw-semibold text-secondary" data-trace="C12-48">
                Rol <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="usuarioRolSelect" data-trace="C12-49" required>
                <option value="">Seleccione un rol institucional...</option>
              </select>
              <div class="invalid-feedback">Seleccione un rol para el usuario.</div>
            </div>

            <div class="mb-2">
              <label for="usuarioPasswordInput" class="form-label small fw-semibold text-secondary" data-trace="C12-50">
                Contraseña temporal <span id="labelPasswordRequerido" class="text-danger">*</span>
              </label>
              <input type="password"
                     class="form-control"
                     id="usuarioPasswordInput"
                     placeholder="Mínimo 10 caracteres alfanuméricos"
                     data-trace="C12-51"
                     autocomplete="new-password">
              <div class="invalid-feedback">La contraseña temporal debe tener al menos 10 caracteres con letras y números.</div>
              <div id="notaPasswordEditar" class="form-text small text-muted d-none">
                Dejar en blanco para mantener la contraseña actual.
              </div>
              <div id="notaPasswordCrear" class="form-text small text-muted">
                Mínimo 10 caracteres alfanuméricos (letras y números). Al primer inicio de sesión se le exigirá cambiarla.
              </div>
            </div>
          </div>

          <div class="modal-footer border-top bg-light py-3 px-4">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-trace="C12-52">
              Cancelar
            </button>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" id="btnGuardarUsuario" data-trace="C12-53">
              <span class="spinner-border spinner-border-sm d-none" id="loaderGuardarUsuario" role="status" aria-hidden="true"></span>
              <span id="textoBtnGuardar">Guardar usuario</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal de Confirmación para Desactivar/Activar Usuario -->
  <div class="modal fade" id="modalConfirmarEstado" tabindex="-1" aria-labelledby="modalConfirmarEstadoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-bottom py-3">
          <h5 class="modal-title fw-bold text-dark" id="modalConfirmarEstadoTitulo">Confirmar cambio de estado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-4">
          <div class="d-flex align-items-start gap-3">
            <div id="iconoConfirmarEstado" class="text-warning">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
              </svg>
            </div>
            <div>
              <p class="mb-2 text-dark" id="mensajeConfirmarEstado">
                ¿Está seguro de cambiar el estado de este usuario?
              </p>
              <p class="small text-muted mb-0" id="detalleConfirmarEstado">
                Al desactivar al usuario, se cerrarán todas sus sesiones activas de manera inmediata.
              </p>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-light py-3 px-4">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Cancelar
          </button>
          <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-2" id="btnConfirmarCambioEstado">
            <span class="spinner-border spinner-border-sm d-none" id="loaderConfirmarEstado" role="status" aria-hidden="true"></span>
            <span id="textoBtnConfirmarEstado">Confirmar</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

