<%- include('../partials/_inicio', { titulo: 'Catálogo de EPS y entidades aseguradoras' }) %>
<!-- Catálogo de EPS y entidades aseguradoras -->

<div class="container-fluid px-0" id="adminAseguradorasApp">

  <!-- Encabezado y Sub-navegación superior del módulo [14.15] -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1" data-trace="C14-15">Catálogo de EPS y entidades aseguradoras</h1>
      <p class="text-muted small mb-0">Gestión del catálogo institucional de EPS, administradoras y planes de cobertura para afiliación de pacientes.</p>
    </div>
  </div>

  <div class="mb-4 border-bottom pb-2">
    <ul class="nav nav-pills gap-2" role="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link text-secondary bg-white border" href="/admin/usuarios" data-trace="C14-15-usr">
          Usuarios
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link text-secondary bg-white border" href="/admin/especialidades" data-trace="C14-15-esp">
          Especialidades
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link active fw-semibold shadow-sm" href="/admin/aseguradoras" data-trace="C14-15-aseg" style="background-color: #0f172a; color: #ffffff;">
          Aseguradoras
        </a>
      </li>
    </ul>
  </div>

  <!-- Barra de control y filtros [14.16 - 14.20] -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 p-md-4">
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6 col-lg-5">
          <label for="filtroBuscarEntidad" class="form-label small fw-semibold text-secondary" data-trace="C14-16">Buscar entidad</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
              </svg>
            </span>
            <input type="text"
                   id="filtroBuscarEntidad"
                   class="form-control border-start-0"
                   placeholder="Nombre de la EPS o aseguradora"
                   data-trace="C14-17"
                   autocomplete="off">
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
          <label for="filtroTipoPlan" class="form-label small fw-semibold text-secondary" data-trace="C14-18">Tipo de plan</label>
          <select id="filtroTipoPlan" class="form-select" data-trace="C14-19">
            <option value="">Todos</option>
            <option value="Contributivo">Contributivo</option>
            <option value="Subsidiado">Subsidiado</option>
            <option value="Especial">Especial</option>
            <option value="Particular">Particular</option>
          </select>
        </div>

        <div class="col-12 col-sm-6 col-md-3 col-lg-4 d-flex justify-content-sm-end gap-2">
          <button type="button"
                  id="btnNuevaEntidad"
                  class="btn btn-primary text-white fw-semibold px-3 shadow-sm d-inline-flex align-items-center gap-2"
                  data-bs-target="#modalFormularioEntidad"
                  data-trace="C14-20">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
            </svg>
            <span>Nueva entidad</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla de catálogo a ancho completo [14.21 - 14.29] -->
  <div class="card border-0 shadow-sm rounded-3 mb-4 hc-tabla-card">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <h2 class="h6 fw-bold text-dark mb-0">Entidades aseguradoras registradas</h2>
        <span class="badge bg-light text-secondary border fw-normal" id="badgeTotalEntidades">0</span>
      </div>
      <div class="spinner-border spinner-border-sm text-primary d-none" id="loaderAseguradoras" role="status">
        <span class="visually-hidden">Cargando...</span>
      </div>
    </div>
    <div class="card-body p-0 hc-tabla-body">
      <div class="hc-tabla-contenedor">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="tablaAseguradoras" data-trace="C14-21">
            <thead class="table-light small text-secondary">
              <tr>
                <th scope="col" class="ps-3 py-3" data-trace="C14-22">Entidad</th>
                <th scope="col" class="py-3" data-trace="C14-23">Tipo de plan</th>
                <th scope="col" class="text-center py-3" data-trace="C14-24">Pacientes afiliados</th>
                <th scope="col" class="text-center py-3" data-trace="C14-25">Estado</th>
                <th scope="col" class="text-end pe-3 py-3" data-trace="C14-26" data-orderable="false">Acciones</th>
              </tr>
            </thead>
            <tbody id="tbodyAseguradoras">
              <tr>
                <td colspan="5" class="text-center py-5 text-muted small">
                  <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                  Cargando catálogo de entidades aseguradoras...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Formulario de Entidad [14.30 - 14.38] -->
  <div class="modal fade" id="modalFormularioEntidad" tabindex="-1" aria-labelledby="panelTituloFormulario" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content border-0 shadow" id="panelFormularioEntidad">
        <div class="modal-header border-bottom py-3 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-2">
            <h2 class="h6 fw-bold modal-title text-white mb-0" id="panelTituloFormulario" data-trace="C14-30">Editar entidad</h2>
            <span class="badge bg-secondary-subtle text-secondary-emphasis small" id="badgeModoFormulario">Edición</span>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-3 p-md-4">
          <form id="formAseguradora" novalidate>
            <input type="hidden" id="inputAseguradoraId" value="">

            <!-- Nombre de la entidad [14.31 - 14.32] -->
            <div class="mb-3">
              <label for="inputNombreEntidad" class="form-label small fw-semibold text-secondary" data-trace="C14-31">
                Nombre de la entidad <span class="text-danger">*</span>
              </label>
              <input type="text"
                     class="form-control"
                     id="inputNombreEntidad"
                     name="nombre"
                     maxlength="150"
                     required
                     placeholder="Ej. EPS Sanitas"
                     data-trace="C14-32"
                     autocomplete="off">
              <div class="form-text small text-muted">Nombre único de la EPS o institución aseguradora.</div>
            </div>

            <!-- Tipo de plan [14.33 - 14.34] -->
            <div class="mb-3">
              <label for="selectTipoPlanEntidad" class="form-label small fw-semibold text-secondary" data-trace="C14-33">
                Tipo de plan <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="selectTipoPlanEntidad" name="tipo_plan" required data-trace="C14-34">
                <option value="Contributivo">Contributivo</option>
                <option value="Subsidiado">Subsidiado</option>
                <option value="Especial">Especial</option>
                <option value="Particular">Particular</option>
              </select>
            </div>

            <!-- Información fija de reglas CHECK [14.35] -->
            <div class="alert alert-info py-2 px-3 small mb-3" data-trace="C14-35">
              <div class="d-flex align-items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle flex-shrink-0 mt-1" viewBox="0 0 16 16">
                  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                  <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                </svg>
                <span>ℹ Los tipos de plan permitidos son Contributivo, Subsidiado, Especial y Particular.</span>
              </div>
            </div>

            <!-- Alerta condicional de afiliados activos [14.36] -->
            <div class="alert alert-warning py-2 px-3 small mb-3 d-none" id="alertaAfiliadosActivos" data-trace="C14-36">
              <div class="d-flex align-items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle flex-shrink-0 mt-1" viewBox="0 0 16 16">
                  <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06c-.033-.06-.034-.123.002-.183L7.884 2.073a.15.15 0 0 1 .054-.057m1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
                  <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                </svg>
                <span>⚠ La entidad tiene afiliaciones activas: no puede eliminarse, solo marcarse como no vigente</span>
              </div>
            </div>

            <!-- Control de Estado Vigente -->
            <div class="mb-3 p-3 bg-light rounded border">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="checkActivoEntidad" checked>
                <label class="form-check-label small fw-semibold text-dark" for="checkActivoEntidad">
                  Entidad activa (Vigente)
                </label>
              </div>
              <div class="small text-muted mt-1" style="font-size: 0.8rem;">
                Las entidades no vigentes no estarán disponibles para nuevas afiliaciones de pacientes.
              </div>
            </div>

            <!-- Alerta dinámica de error en formulario -->
            <div id="alertaFormulario" class="alert alert-danger py-2 px-3 small d-none mb-3" role="alert"></div>

            <!-- Acciones y Botones [14.37 - 14.38] -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
              <div>
                <button type="button" class="btn btn-outline-danger btn-sm d-none" id="btnEliminarEntidad">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-trash me-1" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                  </svg>
                  Eliminar
                </button>
              </div>
              <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" class="btn btn-outline-secondary" id="btnCancelarFormulario" data-trace="C14-37">
                  Cancelar
                </button>
                <button type="button"
                        class="btn btn-primary text-white fw-semibold d-inline-flex align-items-center gap-2"
                        id="btnGuardarEntidad"
                        data-trace="C14-38">
                  <span class="spinner-border spinner-border-sm d-none" id="spinnerGuardarEntidad" role="status" aria-hidden="true"></span>
                  <span id="textoBtnGuardar">Guardar cambios</span>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de confirmación para eliminar entidad -->
  <div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title h6 fw-bold mb-0" id="modalConfirmarEliminarLabel">
            Confirmar eliminación de aseguradora
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-4">
          <p class="mb-2">¿Está seguro de que desea eliminar la entidad aseguradora <strong id="nombreEntidadEliminar"></strong>?</p>
          <p class="text-muted small mb-0">Esta acción no se puede deshacer. Recuerde que solo se permite la eliminación si no cuenta con afiliados asociados.</p>
        </div>
        <div class="modal-footer bg-light border-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-2" id="btnConfirmarEliminacion">
            <span class="spinner-border spinner-border-sm d-none" id="spinnerConfirmarEliminacion" role="status" aria-hidden="true"></span>
            <span>Eliminar definitivamente</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/_fin', { scripts: ['/js/aseguradoras.js'] }) %>
