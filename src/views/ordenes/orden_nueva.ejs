<%- include('../partials/_inicio', { titulo: typeof titulo !== 'undefined' && titulo ? titulo : 'Órdenes diagnósticas - HISCARE' }) %>
<!-- Atención clínica · Órdenes diagnósticas con detalle CUPS -->
<%- include('../partials/_banner_paciente', { figuraTrace: 'C7' }) %>
<%- include('../partials/_tabs_atencion', { figuraTrace: 'C7', seccion: 'ordenes' }) %>

<%
  const atencionId = atencion.id;
  const esCerrada = (atencion.estado === 'CERRADA');
  const esSoloLectura = Boolean((typeof soloLectura !== 'undefined' && soloLectura) || esCerrada);
  const puedeEmitir = Boolean(typeof puedeEditar !== 'undefined' ? puedeEditar : !esSoloLectura);

  // Diagnóstico que justifica la orden médica (C7-22, C7-23)
  let diagTexto = 'Sin diagnóstico principal codificado';
  if (typeof diagnostico !== 'undefined' && diagnostico) {
    if (typeof diagnostico === 'string') {
      diagTexto = diagnostico;
    } else if (diagnostico.codigo && diagnostico.descripcion) {
      diagTexto = `${diagnostico.codigo} ${diagnostico.descripcion}`;
    }
  } else if (atencion.diagnostico_codigo && atencion.diagnostico_desc) {
    diagTexto = `${atencion.diagnostico_codigo} ${atencion.diagnostico_desc}`;
  } else if (atencion.diagnostico_principal) {
    diagTexto = atencion.diagnostico_principal;
  } else if (atencion.diagnostico) {
    diagTexto = atencion.diagnostico;
  }

  // Listado de órdenes diagnósticas previas emitidas en esta atención
  const listaOrdenes = (typeof ordenes !== 'undefined' && Array.isArray(ordenes)) ? ordenes : [];
%>

<div class="row g-4" id="contenedorOrdenNueva"
     data-atencion="<%= atencionId %>"
     data-solo-lectura="<%= esSoloLectura ? 'true' : 'false' %>"
     data-puede-editar="<%= puedeEmitir ? 'true' : 'false' %>">

  <!-- Columna Principal: Generación de la Orden Diagnóstica -->
  <div class="col-12">
    <div class="card shadow-sm border-0 bg-white p-4 mb-4" style="border-radius: 0.5rem;">

      <!-- [7.21] Título de la pantalla -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
        <h1 class="h4 fw-bold text-dark mb-0" data-trace="C7-21">Generación de orden diagnóstica</h1>
        <% if (esSoloLectura) { %>
          <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
            Modo solo lectura
          </span>
        <% } %>
      </div>

      <!-- [7.22–7.23] Diagnóstico que lo justifica -->
      <div class="d-flex flex-wrap align-items-center gap-2 mb-4 pb-2 border-bottom">
        <span class="text-secondary small fw-semibold" data-trace="C7-22">Diagnóstico que lo justifica:</span>
        <span class="badge bg-light text-dark border px-2 py-1 fs-6 font-monospace fw-normal" data-trace="C7-23"><%= diagTexto %></span>
      </div>

      <!-- [7.24–7.25] Pestañas/Botones de Tipo de Orden: Laboratorio / Radiología -->
      <div class="mb-4">
        <div class="btn-group" role="group" aria-label="Tipo de orden diagnóstica" id="grupoTipoOrden">
          <button type="button"
                  class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2 active"
                  id="btnTipoLaboratorio"
                  data-tipo="LABORATORIO"
                  data-trace="C7-24">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
            </svg>
            <span>Laboratorio</span>
          </button>
          <button type="button"
                  class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-4 py-2"
                  id="btnTipoRadiologia"
                  data-tipo="RADIOLOGIA"
                  data-trace="C7-25">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
            </svg>
            <span>Radiología</span>
          </button>
        </div>
      </div>

      <!-- [7.26] Buscador de procedimiento o código CUPS -->
      <div class="position-relative mb-4" id="contenedorBuscadorCups">
        <label for="buscarCups" class="form-label fw-semibold text-secondary small mb-1">
          Buscar procedimiento o código CUPS
        </label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" id="addonBuscarCups">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </span>
          <input type="text"
                 id="buscarCups"
                 class="form-control border-start-0 ps-0 shadow-none py-2"
                 placeholder="Buscar procedimiento o código CUPS..."
                 aria-label="Buscar procedimiento o código CUPS..."
                 aria-describedby="addonBuscarCups"
                 autocomplete="off"
                 data-trace="C7-26"
                 <%= esSoloLectura ? 'disabled' : '' %>>
          <span class="input-group-text bg-white text-muted d-none" id="spinnerBuscarCups">
            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
          </span>
        </div>

        <!-- Menú flotante de resultados desplegable (HIS-NF-11) -->
        <div id="dropdownCups"
             class="dropdown-menu w-100 shadow-lg p-0 mt-1 border rounded-3 d-none position-absolute"
             style="z-index: 1055; max-height: 320px; overflow-y: auto; top: 100%; left: 0; right: 0;">
          <div id="listaResultadosCups" class="list-group list-group-flush">
            <!-- Rellenado dinámicamente por orden_nueva.js -->
          </div>
        </div>
        <div class="form-text text-muted small mt-1">
          Ingrese código o nombre del procedimiento. Seleccione el examen de la lista para agregarlo a la orden (no se permite texto libre).
        </div>
      </div>

      <!-- [7.27–7.33] Tabla de exámenes agregados -->
      <div class="table-responsive mb-4 border rounded-3 bg-white">
        <table class="table table-hover align-middle mb-0" id="tablaProcedimientos" data-trace="C7-27">
          <thead class="table-light text-secondary small text-uppercase">
            <tr>
              <th scope="col" style="width: 18%;" class="ps-3 py-3" data-trace="C7-28">Código CUPS</th>
              <th scope="col" style="width: 52%;" class="py-3" data-trace="C7-29">Descripción</th>
              <th scope="col" style="width: 15%;" class="text-center py-3" data-trace="C7-30">Cantidad</th>
              <th scope="col" style="width: 15%;" class="text-end pe-3 py-3" data-trace="C7-31">Acción</th>
            </tr>
          </thead>
          <tbody id="cuerpoTablaProcedimientos">
            <!-- Estado vacío elegante inicial -->
            <tr id="filaSinProcedimientos">
              <td colspan="4" class="text-center text-muted py-5">
                <div class="d-flex flex-column align-items-center gap-2">
                  <svg width="36" height="36" fill="none" stroke="currentColor" class="text-secondary opacity-50" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                  </svg>
                  <span class="fw-medium text-dark">No hay exámenes agregados en esta orden.</span>
                  <span class="small text-secondary">Utilice el buscador superior para agregar procedimientos CUPS a la orden médica.</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>

        <!-- [7.32–7.33] Plantilla para renderizado dinámico de filas de exámenes -->
        <template id="templateFilaProcedimiento">
          <tr class="fila-procedimiento">
            <td class="ps-3 font-monospace fw-bold text-dark col-codigo"></td>
            <td class="text-dark col-descripcion"></td>
            <td class="text-center">
              <input type="number"
                     class="form-control form-control-sm text-center mx-auto input-cantidad"
                     style="max-width: 85px;"
                     min="1"
                     max="99"
                     step="1"
                     value="1"
                     data-trace="C7-32"
                     aria-label="Cantidad de procedimientos">
            </td>
            <td class="text-end pe-3">
              <button type="button"
                      class="btn btn-sm btn-outline-danger btn-eliminar-item"
                      data-trace="C7-33"
                      title="Eliminar examen">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </button>
            </td>
          </tr>
        </template>
      </div>

      <!-- [7.34–7.36] Barra de acciones inferiores -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-top pt-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <button type="button"
                  class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
                  id="btnGuardarBorrador"
                  data-trace="C7-34"
                  <%= esSoloLectura ? 'disabled' : '' %>>
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
            </svg>
            <span>Guardar como borrador</span>
          </button>
          <button type="button"
                  class="btn btn-outline-danger"
                  id="btnCancelarOrden"
                  data-trace="C7-35"
                  <%= esSoloLectura ? 'disabled' : '' %>>
            Cancelar
          </button>
          <span id="avisoBorrador" class="text-muted small ms-2 d-none fst-italic"></span>
        </div>

        <div>
          <button type="button"
                  class="btn btn-success d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold shadow-sm"
                  id="btnGenerarOrden"
                  data-trace="C7-36"
                  <%= esSoloLectura ? 'disabled' : '' %>>
            <span class="spinner-border spinner-border-sm d-none" id="spinnerGenerar" role="status" aria-hidden="true"></span>
            <svg id="iconoGenerar" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="textoGenerar">Generar orden médica</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Sección Inferior: Órdenes emitidas en esta atención -->
  <div class="col-12">
    <div class="card shadow-sm border-0 bg-white p-4" style="border-radius: 0.5rem;" id="seccionOrdenesEmitidas">
      <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <h2 class="h5 fw-bold text-dark mb-0">Órdenes emitidas en esta atención</h2>
        <span class="badge bg-light text-secondary border px-2 py-1" id="conteoOrdenesPrevias">
          <%= listaOrdenes.length %> orden<%= listaOrdenes.length === 1 ? '' : 'es' %>
        </span>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tablaOrdenesEmitidas">
          <thead class="table-light text-secondary small text-uppercase">
            <tr>
              <th scope="col" class="ps-3 py-2">Código</th>
              <th scope="col" class="py-2">Tipo</th>
              <th scope="col" class="py-2">Fecha y hora</th>
              <th scope="col" class="py-2">Estado</th>
              <th scope="col" class="text-center py-2">Procedimientos</th>
              <th scope="col" class="text-end pe-3 py-2">Acción</th>
            </tr>
          </thead>
          <tbody id="cuerpoTablaOrdenesEmitidas">
            <% if (listaOrdenes.length === 0) { %>
              <tr id="filaSinOrdenesEmitidas">
                <td colspan="6" class="text-center text-muted py-4">
                  No se han emitido órdenes diagnósticas en esta atención clínica.
                </td>
              </tr>
            <% } else { %>
              <% listaOrdenes.forEach(o => { %>
                <%
                  let badgeEstado = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                  if (o.estado === 'EN_PROCESO') badgeEstado = 'bg-info-subtle text-info-emphasis border border-info-subtle';
                  else if (o.estado === 'COMPLETADA') badgeEstado = 'bg-success text-white';
                  else if (o.estado === 'CANCELADA') badgeEstado = 'bg-danger text-white';

                  const badgeTipo = o.tipo === 'LABORATORIO' ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-info-subtle text-info-emphasis border border-info-subtle';
                  const fechaFormateada = o.fecha_formateada || (o.fecha ? new Date(o.fecha).toLocaleString('es-CO') : '—');
                  const cantItems = o.cantidad_procedimientos || o.total_items || (Array.isArray(o.items) ? o.items.length : 1);
                %>
                <tr>
                  <td data-label="Código" class="ps-3">
                    <span class="badge bg-light text-dark font-monospace border px-2 py-1"><%= o.codigo %></span>
                  </td>
                  <td data-label="Tipo">
                    <span class="badge <%= badgeTipo %> px-2 py-1"><%= o.tipo %></span>
                  </td>
                  <td data-label="Fecha y hora" class="text-secondary small"><%= fechaFormateada %></td>
                  <td data-label="Estado">
                    <span class="badge <%= badgeEstado %>"><%= o.estado %></span>
                  </td>
                  <td data-label="Procedimientos" class="text-center font-monospace"><%= cantItems %></td>
                  <td data-label="Acción" class="text-end pe-3">
                    <a href="/ordenes/<%= o.id %>/imprimir"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                      </svg>
                      <span>Imprimir</span>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- Modal de Orden Emitida Exitosamente -->
<div class="modal fade" id="modalOrdenEmitida" tabindex="-1" aria-labelledby="modalOrdenEmitidaTitulo" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow-lg border-0 rounded-3">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-success d-flex align-items-center gap-2" id="modalOrdenEmitidaTitulo">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Orden médica generada exitosamente</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body text-center py-4">
        <div class="mb-2 text-secondary small">Código oficial de orden asignado</div>
        <div class="display-6 font-monospace fw-bold text-primary mb-3" id="codigoOrdenModal">ORD-00000</div>
        <div class="alert alert-success bg-success-subtle text-success-emphasis border-0 py-2 small mb-0">
          La orden ha sido registrada exitosamente con estado <strong>PENDIENTE</strong> dentro del módulo clínico HISCARE.
        </div>
      </div>
      <div class="modal-footer border-0 pt-0 justify-content-between">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnCerrarModalOrden">
          Cerrar
        </button>
        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary d-inline-flex align-items-center gap-2" id="btnImprimirOrdenModal">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
          </svg>
          <span>Imprimir orden</span>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/_fin', { scripts: ['/js/orden_nueva.js'] }) %>
