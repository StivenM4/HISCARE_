<%- include('../partials/_inicio', { titulo: 'Agenda médica diaria' }) %>
  <% const puedeEscribir=typeof usuario !=='undefined' && usuario && (usuario.rol==='MEDICO' ||
    usuario.rol==='RECEPCIONISTA' || usuario.rol==='ENFERMERO' || usuario.rol==='ADMINISTRADOR' ); const esMedico=typeof
    usuario !=='undefined' && usuario && usuario.rol==='MEDICO' ; const filasCitas=(typeof filas !=='undefined' &&
    Array.isArray(filas)) ? filas : []; let inds=(typeof indicadores !=='undefined' && indicadores) ? indicadores :
    null; if (!inds) { const total=filasCitas.length; const en_sala=filasCitas.filter(c=> c.estado ===
    'EN_SALA').length;
    const atendidas = filasCitas.filter(c => c.estado === 'ATENDIDA').length;
    const canceladas_no_asistio = filasCitas.filter(c => c.estado === 'CANCELADA' || c.estado === 'NO_ASISTIO').length;
    inds = { total, en_sala, atendidas, canceladas_no_asistio };
    }

    let pacientesSala = (typeof salaEspera !== 'undefined' && Array.isArray(salaEspera) && salaEspera.length) ?
    salaEspera : [];
    if (!pacientesSala.length && filasCitas.length) {
    pacientesSala = filasCitas
    .filter(c => c.estado === 'EN_SALA')
    .map(c => ({
    cita_id: c.id,
    paciente: c.paciente,
    hora_llegada: c.hora_llegada || c.hora_llegada_formato || c.hora || '--:--',
    minutos_espera: c.minutos_espera != null ? c.minutos_espera : 0,
    }));
    }

    const fParts = (typeof fecha === 'string' && fecha) ? fecha.split('-') : ['2026', '09', '21'];
    const diasSem = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
    let diaStr = 'Lun';
    if (fParts.length === 3) {
    const dt = new Date(Number(fParts[0]), Number(fParts[1]) - 1, Number(fParts[2]));
    diaStr = diasSem[dt.getDay()] || 'Lun';
    }
    const fechaVisual = diaStr + ' ' + (fParts[2] || '21') + '/' + (fParts[1] || '09') + '/' + (fParts[0] || '2026');
    %>

    <div class="container-fluid px-0">
      <!-- Encabezado y Filtros [18.15 - 18.17] -->
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <h1 class="h4 mb-1 fw-bold text-dark" data-trace="C18-15">Agenda médica diaria</h1>
          <span class="text-muted small">Control de citas, sala de espera e inicio de atención clínica</span>
        </div>

        <form class="d-flex flex-wrap align-items-center gap-2 agenda-filter-form" method="get" action="/agenda">
          <% if (!esMedico) { %>
            <div class="d-flex align-items-center gap-1">
              <label for="selectMedico" class="form-label small text-muted mb-0 me-1">Profesional:</label>
              <select name="medico" id="selectMedico" class="form-select form-select-sm shadow-sm" data-trace="C18-16">
                <% (typeof medicos !=='undefined' ? medicos : []).forEach(m=> { %>
                  <option value="<%= m.id %>" <%=m.id===medicoId ? 'selected' : '' %>><%= m.nombre %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <% } else { %>
              <input type="hidden" name="medico" id="selectMedico" value="<%= medicoId %>">
              <% } %>

                <div class="d-flex align-items-center gap-1">
                  <label for="inputFecha" class="form-label small text-muted mb-0 me-1">Fecha:</label>
                  <div class="input-group input-group-sm">
                    <input type="date" name="fecha" id="inputFecha" value="<%= fecha %>"
                      class="form-control form-control-sm" data-trace="C18-17">
                    <span class="input-group-text bg-light text-muted small fw-semibold">
                      <%= fechaVisual %>
                    </span>
                  </div>
                </div>

                <button type="submit" class="btn btn-outline-primary btn-sm">Consultar</button>
        </form>
      </div>

      <!-- Indicadores Superiores por Estado [18.24] -->
      <div class="row g-3 mb-4" data-trace="C18-24">
        <!-- Citas del día [18.18 - 18.19] -->
        <div class="col-6 col-md-3">
          <div class="card kpi-card shadow-sm border-0 rounded-3 h-100 bg-white">
            <div class="card-body py-3 px-3">
              <div class="text-muted small fw-semibold text-uppercase" data-trace="C18-18">Citas del día</div>
              <div class="fs-3 fw-bold text-dark mt-1" data-trace="C18-19" id="kpiTotal">
                <%= inds.total %>
              </div>
            </div>
          </div>
        </div>

        <!-- En sala de espera [18.20 - 18.21] -->
        <div class="col-6 col-md-3">
          <div class="card kpi-card shadow-sm border-0 rounded-3 h-100 bg-white border-start border-4 border-warning">
            <div class="card-body py-3 px-3">
              <div class="text-muted small fw-semibold text-uppercase" data-trace="C18-20">En sala de espera</div>
              <div class="fs-3 fw-bold text-warning-emphasis mt-1" data-trace="C18-21" id="kpiEnSala">
                <%= inds.en_sala %>
              </div>
            </div>
          </div>
        </div>

        <!-- Atendidas [18.22 - 18.23] -->
        <div class="col-6 col-md-3">
          <div class="card kpi-card shadow-sm border-0 rounded-3 h-100 bg-white border-start border-4 border-success">
            <div class="card-body py-3 px-3">
              <div class="text-muted small fw-semibold text-uppercase" data-trace="C18-22">Atendidas</div>
              <div class="fs-3 fw-bold text-success mt-1" data-trace="C18-23" id="kpiAtendidas">
                <%= inds.atendidas %>
              </div>
            </div>
          </div>
        </div>

        <!-- Canceladas / no asistió [18.25 - 18.26] -->
        <div class="col-6 col-md-3">
          <div class="card kpi-card shadow-sm border-0 rounded-3 h-100 bg-white border-start border-4 border-danger">
            <div class="card-body py-3 px-3">
              <div class="text-muted small fw-semibold text-uppercase" data-trace="C18-25">Canceladas / no asistió</div>
              <div class="fs-3 fw-bold text-danger mt-1" data-trace="C18-26" id="kpiCanceladas">
                <%= inds.canceladas_no_asistio %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Layout Principal de 2 Columnas: Citas y Sala de Espera -->
      <div class="row g-4 align-items-stretch">
        <!-- Columna Izquierda: Grilla de Citas [18.27] -->
        <div class="col-lg-8">
          <div class="card card-agenda-citas h-100 hc-tabla-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-2">
                <span
                  class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-2"
                  style="width: 32px; height: 32px;">
                  <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path
                      d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                  </svg>
                </span>
                <div>
                  <h6 class="card-title fw-bold text-dark mb-0">Programación de Citas</h6>
                  <span class="text-muted small" style="font-size: 0.75rem;">Agenda de consultas médicas del día</span>
                </div>
              </div>
              <span class="badge agenda-badge-count">
                <%= filasCitas.length %> citas registradas
              </span>
            </div>
            <div class="card-body p-0 hc-tabla-body">
              <div class="hc-tabla-contenedor">
                <div class="table-responsive border-0">
                  <table class="table table-hover align-middle mb-0" id="tablaAgenda" data-trace="C18-27" data-rol="<%= typeof usuario !== 'undefined' && usuario ? usuario.rol : '' %>" data-puede-escribir="<%= puedeEscribir ? 'true' : 'false' %>">
                    <thead class="table-light">
                      <tr>
                        <th scope="col" style="width: 105px;" data-trace="C18-28">Hora</th>
                        <th scope="col" data-trace="C18-29">Paciente</th>
                        <th scope="col" style="width: 160px;" data-trace="C18-30">Estado</th>
                        <th scope="col" style="width: 230px;" class="text-end" data-trace="C18-31" data-orderable="false">Acción</th>
                      </tr>
                    </thead>
                <tbody id="cuerpoTablaAgenda">
                  <% if (!filasCitas.length) { %>
                    <tr>
                      <td colspan="4" class="text-center py-5 text-muted">
                        <div class="text-muted mb-1" style="font-size: 1.5rem;">📋</div>
                        <div class="fw-medium">No hay citas programadas</div>
                        <div class="small text-muted">No se encontraron turnos para este profesional en la fecha
                          seleccionada.</div>
                      </td>
                    </tr>
                    <% } else { %>
                      <% filasCitas.forEach(c=> { %>
                        <tr data-cita="<%= c.id %>" data-paciente="<%= c.paciente %>">
                          <td data-label="Hora" class="cell-time">
                            <span class="agenda-hora-pill">
                              <%= c.hora %>
                            </span>
                          </td>
                          <td data-label="Paciente">
                            <span class="fw-semibold text-dark">
                              <%= c.paciente %>
                            </span>
                          </td>
                          <td data-label="Estado">
                            <% if (c.estado==='PROGRAMADA' ) { %>
                              <span
                                class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"
                                data-trace="C18-30">PROGRAMADA</span>
                              <% } else if (c.estado==='CONFIRMADA' ) { %>
                                <span
                                  class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"
                                  data-trace="C18-30">CONFIRMADA</span>
                                <% } else if (c.estado==='EN_SALA' ) { %>
                                  <span
                                    class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"
                                    data-trace="C18-30">En sala de espera</span>
                                  <% } else if (c.estado==='ATENDIDA' ) { %>
                                    <span
                                      class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1"
                                      data-trace="C18-32">ATENDIDA</span>
                                    <% } else if (c.estado==='CANCELADA' ) { %>
                                      <span
                                        class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"
                                        data-trace="C18-30">CANCELADA</span>
                                      <% } else if (c.estado==='NO_ASISTIO' ) { %>
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1"
                                          data-trace="C18-30">No asistió</span>
                                        <% } else { %>
                                          <span class="badge rounded-pill bg-light text-secondary border px-2 py-1"
                                            data-trace="C18-30">
                                            <%= c.estado %>
                                          </span>
                                          <% } %>
                          </td>
                          <td data-label="Acción" class="text-end cell-actions" data-trace="C18-31">
                            <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                              <% if (c.estado==='PROGRAMADA' ) { %>
                                <button type="button" data-accion="estado" data-loading-text="Confirmando..." class="btn btn-sm btn-outline-primary btn-accion-estado" data-id="<%= c.id %>" data-estado="CONFIRMADA" <%=puedeEscribir ? '' : 'disabled' %>>Confirmar</button>
                                <div class="dropdown">
                                  <button class="btn btn-sm btn-light text-muted border-0 py-1 px-2" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false" title="Más opciones" aria-label="Más opciones" <%=puedeEscribir ? '' : 'disabled'
                                    %>>
                                    &#8942;
                                  </button>
                                  <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li><a class="dropdown-item small" href="/citas/<%= c.id %>">Reprogramar</a></li>
                                    <li><a class="dropdown-item small text-danger"
                                        href="/citas/<%= c.id %>?accion=cancelar">Cancelar cita</a></li>
                                    <li><button class="dropdown-item small text-secondary btn-abrir-no-asistio"
                                        type="button" data-id="<%= c.id %>" data-paciente="<%= c.paciente %>"
                                        data-accion="abrir-no-asistio">No asistió</button></li>
                                  </ul>
                                </div>
                                <% } else if (c.estado==='CONFIRMADA' ) { %>
                                  <button type="button" data-accion="estado" data-loading-text="Registrando llegada..." class="btn btn-sm btn-outline-primary btn-accion-estado" data-id="<%= c.id %>" data-estado="EN_SALA" <%=puedeEscribir ? '' : 'disabled' %>>Registrar llegada</button>
                                  <div class="dropdown">
                                    <button class="btn btn-sm btn-light text-muted border-0 py-1 px-2" type="button"
                                      data-bs-toggle="dropdown" aria-expanded="false" title="Más opciones" aria-label="Más opciones" <%=puedeEscribir ? '' : 'disabled'
                                      %>>
                                      &#8942;
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                      <li><a class="dropdown-item small" href="/citas/<%= c.id %>">Reprogramar</a></li>
                                      <li><a class="dropdown-item small text-danger"
                                          href="/citas/<%= c.id %>?accion=cancelar">Cancelar cita</a></li>
                                      <li><button class="dropdown-item small text-secondary btn-abrir-no-asistio"
                                          type="button" data-id="<%= c.id %>" data-paciente="<%= c.paciente %>"
                                          data-accion="abrir-no-asistio">No asistió</button></li>
                                    </ul>
                                  </div>
                                  <% } else if (c.estado==='EN_SALA' ) { %>
                                    <% if (esMedico || (typeof usuario !=='undefined' && usuario &&
                                      usuario.rol==='ADMINISTRADOR' )) { %>
                                      <button type="button"
                                        class="btn btn-sm btn-primary fw-semibold btn-iniciar-atencion"
                                        data-id="<%= c.id %>" data-cita-id="<%= c.id %>" data-accion="iniciar" data-loading-text="Iniciando...">
                                        Iniciar atención
                                      </button>
                                      <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1 px-2 rounded-pill">Esperando médico</span>
                                      <% } %>
                                          <div class="dropdown">
                                            <button class="btn btn-sm btn-light text-muted border-0 py-1 px-2"
                                              type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                              title="Más opciones" aria-label="Más opciones"
                                              <%=puedeEscribir ? '' : 'disabled' %>>
                                              &#8942;
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                              <li><a class="dropdown-item small text-danger"
                                                  href="/citas/<%= c.id %>?accion=cancelar">Cancelar cita</a></li>
                                              <li><button
                                                  class="dropdown-item small text-secondary btn-abrir-no-asistio"
                                                  type="button" data-id="<%= c.id %>" data-paciente="<%= c.paciente %>"
                                                  data-accion="abrir-no-asistio">No asistió</button></li>
                                            </ul>
                                          </div>
                                          <% } else if (c.estado==='ATENDIDA' ) { %>
                                            <% if (c.atencion_id) { %>
                                              <a class="btn btn-sm btn-outline-secondary"
                                                href="/atenciones/<%= c.atencion_id %>/consulta" data-trace="C18-33">
                                                Ver atención
                                              </a>
                                              <% } else { %>
                                                <span class="text-muted small">Atendida</span>
                                                <% } %>
                                                  <% } else { %>
                                                    <span class="text-muted small">—</span>
                                                    <% } %>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                          <% } %>
                </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Sala de Espera [18.34 - 18.40] -->
        <div class="col-lg-4">
          <div class="card card-agenda-sala h-100 hc-tabla-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-2">
                <span
                  class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-2"
                  style="width: 32px; height: 32px;">
                  <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path
                      d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" />
                  </svg>
                </span>
                <div>
                  <h6 class="card-title fw-bold text-dark mb-0" data-trace="C18-34">Sala de espera (vista del
                    consultorio)</h6>
                  <span class="text-muted small" style="font-size: 0.75rem;">Monitoreo en tiempo real</span>
                </div>
              </div>
              <span class="badge badge-live-pulse" id="badgeSalaCount">
                <%= pacientesSala.length %> en espera
              </span>
            </div>
            <div class="card-body p-0 flex-grow-1 hc-tabla-body hc-tabla-body--compact">
              <div class="hc-tabla-contenedor">
                <div class="table-responsive border-0">
                <table class="table table-sm table-hover align-middle mb-0" id="tablaSalaEspera" data-trace="C18-35">
                  <thead class="table-light">
                    <tr>
                      <th scope="col" style="width: 85px;" data-trace="C18-36">Llegada</th>
                      <th scope="col" data-trace="C18-37">Paciente</th>
                      <th scope="col" style="width: 95px;" class="text-end" data-trace="C18-38">Espera</th>
                    </tr>
                  </thead>
                  <tbody id="cuerpoSalaEspera">
                    <% if (!pacientesSala.length) { %>
                      <tr id="filaSinSala">
                        <td colspan="3" class="text-center py-5 text-muted small">
                          <div class="text-muted mb-1" style="font-size: 1.4rem;">☕</div>
                          <div class="fw-medium">No hay pacientes en espera</div>
                          <div class="text-muted" style="font-size: 0.75rem;">Los pacientes que registren llegada
                            aparecerán aquí automáticamente.</div>
                        </td>
                      </tr>
                      <% } else { %>
                        <% pacientesSala.forEach(p=> { %>
                          <% const mEsp=p.minutos_espera !=null ? p.minutos_espera : 0; %>
                            <% const badgeClass=mEsp> 30 ? 'badge-espera-urgente' : (mEsp >= 15 ?
                              'badge-espera-moderada' : 'badge-espera-normal'); %>
                              <tr data-cita="<%= p.cita_id %>">
                                <td data-label="Llegada" class="text-muted small cell-time">
                                  <%= p.hora_llegada %>
                                </td>
                                <td data-label="Paciente" class="fw-semibold text-dark small">
                                  <%= p.paciente %>
                                </td>
                                <td data-label="Espera" class="text-end small">
                                  <span class="badge <%= badgeClass %> rounded-pill px-2 py-1">
                                    <%= mEsp %> min
                                  </span>
                                </td>
                              </tr>
                              <% }) %>
                                <% } %>
                  </tbody>
                </table>
                </div>
              </div>
            </div>

            <!-- Footer Desacoplado de la Tarjeta de Sala de Espera [18.39 - 18.40] -->
            <div class="card-footer p-3 bg-light border-top">
              <div class="alert alert-info py-2 px-3 small mb-2 border-0" data-trace="C18-39">
                Los pacientes en sala de espera se actualizan automáticamente según su orden de llegada.
              </div>
              <div class="text-muted small" style="font-size: 0.75rem;" data-trace="C18-40">
                El inicio de la atención clínica trasladará al paciente de la sala de espera al consultorio.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal de Confirmación para "No asistió" -->
    <div class="modal fade" id="modalNoAsistio" tabindex="-1" aria-labelledby="modalNoAsistioLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header border-bottom">
            <h5 class="modal-title fs-6 fw-bold text-dark" id="modalNoAsistioLabel">Confirmar inasistencia</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body py-4">
            <p class="mb-2">¿Está seguro de que desea marcar como <strong>No asistió</strong> la cita del paciente?</p>
            <p class="fw-bold text-dark mb-2" id="modalPacienteNombre">—</p>
            <div class="alert alert-warning py-2 px-3 small mb-0 border-0">
              Esta acción cerrará la cita por inasistencia y no podrá ser reactivada.
            </div>
            <input type="hidden" id="modalCitaId" value="">
          </div>
          <div class="modal-footer border-top bg-light">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-sm btn-danger fw-semibold" id="btnConfirmarNoAsistio">Confirmar No asistió</button>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/_fin', { scripts: ['/js/agenda_diaria.js'] }) %>